import { ListView, ScrollView, Spinner } from "std-widgets.slint";

// Shared toolbar metrics, so the standalone buttons and the segmented controls
// give their icons the same breathing room.
global Toolbar {
    out property <length> icon-size: 18px;
    out property <length> h-padding: 16px;
}

// One page's fixed size (in PDF points) and its rendered image. The image is
// empty until the page has been rendered.
export struct PageEntry {
    page: int,
    width-pt: float,
    height-pt: float,
    image: image,
}

// A row in the document: a single page, or two pages side by side (a spread).
// When `has-right` is false, `right` is unused.
export struct PageRow {
    left: PageEntry,
    right: PageEntry,
    has-right: bool,
}

// One entry in the document outline (table of contents).
export struct OutlineItem {
    title: string,
    page: int,
    depth: int,
}

// A single page: white paper with the rendered image on top. Sized from the
// page's points times the shared density.
component PageImageView inherits Rectangle {
    in property <PageEntry> entry;
    in property <float> density;
    width: entry.width-pt * density * 1px;
    height: entry.height-pt * density * 1px;
    background: white;
    Image {
        source: entry.image;
        width: 100%;
        height: 100%;
    }

    // A spinner while the page has not been rendered yet (empty image). It
    // disappears as soon as the rendered image arrives.
    if entry.image.width == 0: Spinner {
        width: min(36px, parent.width / 4);
        height: self.width;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        indeterminate: true;
    }
}

// A single fixed-size page thumbnail for the sidebar. The image is letterboxed
// into a uniform box so every thumbnail row is the same height (which the
// sidebar ListView needs for stable scrolling).
component ThumbView inherits Rectangle {
    in property <PageEntry> entry;
    width: 96px;
    height: 128px;
    background: white;
    border-width: 1px;
    border-color: #555555;

    Image {
        source: entry.image;
        width: 100%;
        height: 100%;
        image-fit: contain;
    }

    if entry.image.width == 0: Spinner {
        width: 24px;
        height: 24px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        indeterminate: true;
    }
}

// One row, centered horizontally and vertically. A single page centers on its
// own; a spread centers as a pair so the two pages meet at the middle.
//
// Every row reserves the same height (`row-height-pt`, the tallest row in the
// document). Slint's ListView assumes uniform item heights when estimating the
// scroll extent; giving it exactly that keeps the viewport anchor stable while
// scrolling instead of oscillating, which otherwise triggers a long
// instantiation-chain warning.
component PageRowView inherits Rectangle {
    in property <PageRow> page-row;
    in property <float> density;
    in property <float> row-height-pt;
    height: row-height-pt * density * 1px + 16px;
    background: #2b2b2b;

    HorizontalLayout {
        alignment: center;
        spacing: 4px;

        VerticalLayout {
            alignment: center;
            PageImageView {
                entry: page-row.left;
                density: root.density;
            }
        }
        if page-row.has-right: VerticalLayout {
            alignment: center;
            PageImageView {
                entry: page-row.right;
                density: root.density;
            }
        }
    }
}

// One segment of a fused segmented control. The active segment is recessed
// (darker) so it reads as pressed in. Its content is tinted to match the state.
// Carries an icon, or a text label where pdf.js has no icon to borrow.
component Segment inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> active;
    in property <bool> divider;
    // Slint has no minimum-padding property, but an inner layout is the same
    // thing: its padding is part of the segment's minimum width, so this is the
    // narrowest gap the content can ever get, and a wider segment just centers
    // the content in the extra space.
    in property <length> h-padding;
    callback clicked <=> touch.clicked;

    // Recessed while selected (radio use) or held down (action use).
    background: (root.active || touch.pressed)
        ? #252525
        : (touch.has-hover ? #505050 : #454545);
    property <brush> tint: (root.active || touch.pressed) ? #ffffff : #b8b8b8;

    HorizontalLayout {
        alignment: center;
        padding-left: root.h-padding;
        padding-right: root.h-padding;

        // The icon is a fixed size, which a HorizontalLayout would otherwise pin
        // to the top of the segment, so center it on the cross axis by hand.
        if root.label == "": VerticalLayout {
            alignment: center;
            icon-image := Image {
                source: root.icon;
                width: Toolbar.icon-size;
                height: self.width;
                // The source icons are solid black, so colorize carries the tint.
                colorize: root.tint;
            }
        }

        if root.label != "": label-text := Text {
            text: root.label;
            color: root.tint;
            font-size: 13px;
            vertical-alignment: center;
        }
    }

    // Divider between segments (drawn on the left edge of all but the first).
    if root.divider: Rectangle {
        x: 0;
        width: 1px;
        background: #5a5a5a;
    }

    touch := TouchArea { }
}

// A fused, segmented toggle: the options render as one control with rounded ends
// and shared borders. Emits `select` with the chosen index. A control fills
// either `options` (icons) or `labels` (text), never both.
component SegmentedControl inherits Rectangle {
    in property <[image]> options;
    in property <[string]> labels;
    in property <int> current;
    // Guaranteed gap on each side of every segment's icon or label, which is
    // what sizes the control now that it hugs its content.
    in property <length> segment-padding: Toolbar.h-padding;
    callback select(int);

    height: 28px;
    // A Rectangle has no natural width, so without this the control would
    // stretch to fill the toolbar instead of hugging its segments.
    horizontal-stretch: 0;
    border-width: 1px;
    border-color: #5a5a5a;
    border-radius: 5px;
    // Clip so the square-cornered segments are rounded off at the ends.
    clip: true;

    HorizontalLayout {
        for option[idx] in root.options: Segment {
            icon: option;
            active: idx == root.current;
            divider: idx > 0;
            h-padding: root.segment-padding;
            clicked => {
                root.select(idx);
            }
        }
        for text[idx] in root.labels: Segment {
            label: text;
            active: idx == root.current;
            divider: idx > 0;
            h-padding: root.segment-padding;
            clicked => {
                root.select(idx);
            }
        }
    }
}

// An editable page-number field. Shows the current page and, on Enter, emits the
// typed text for the viewer to jump to. Styled to match the dark toolbar.
component PageField inherits Rectangle {
    in property <int> page;
    callback go-to(string);

    width: 48px;
    height: 26px;
    border-width: 1px;
    border-color: #5a5a5a;
    border-radius: 4px;
    background: #2b2b2b;

    input := TextInput {
        width: 100%;
        height: 100%;
        // One-way binding: user edits persist until `page` changes externally
        // (scroll/nav), which then refreshes the field.
        text: "\{root.page}";
        color: #eeeeee;
        font-size: 14px;
        horizontal-alignment: center;
        vertical-alignment: center;
        single-line: true;
        input-type: number;
        accepted => {
            root.go-to(self.text);
        }
    }
}

// Top-level window: a toolbar above the document, shown either as a continuous
// scrollable column of rows or one row at a time.
export component MainWindow inherits Window {
    in property <[PageRow]> rows;
    in property <PageRow> current-row-content;
    in property <bool> continuous: true;
    in property <float> density: 1.333;
    in property <float> row-height-pt: 1.0;
    // Spread mode for the toolbar radios: 0 = single, 1 = odd, 2 = even.
    in property <int> spread-mode;
    // 1-based page currently at the top of the view, and total page count.
    in property <int> current-page;
    in property <int> page-count;
    // Two-way bound to the ListView's scroll offset so Rust can jump to a page.
    in-out property <length> scroll-y;
    // Shown in the document area only when there are no pages (errors/usage).
    in property <string> status;

    // Sidebar: the document outline, thumbnail rows (grouped like the current
    // spread mode), and which tab is showing (0 = outline, 1 = pages).
    in property <[OutlineItem]> outline;
    in property <[PageRow]> thumb-rows;
    in-out property <bool> sidebar-open: true;
    in-out property <int> sidebar-tab;

    // The name of the open document, shown in the window title bar.
    in property <string> doc-title;

    // Open a new PDF (prompts for a file with a native picker).
    callback open-document();
    callback toggle-sidebar();
    // Jump to a 0-based page (from the outline or a thumbnail).
    callback go-to-page-index(int);
    // A visible thumbnail row wants its pages rendered (row index).
    callback request-thumbnail-row(int);
    // Invoked from Rust when a page thumbnail has rendered (page index, image).
    callback thumbnail-rendered(int, image);
    callback request-render-row(int);
    callback page-rendered(int, image);
    callback viewport-resized(length, length);
    // Continuous scroll offset changed (logical pixels from the top).
    callback scrolled(float);
    callback zoom-in();
    callback zoom-out();
    callback zoom-reset();
    callback fit-width();
    callback fit-page();
    callback set-continuous(bool);
    callback toggle-continuous();
    // Jump to a page from the toolbar field (raw text, parsed in Rust).
    callback go-to-page(string);
    // Spread mode: 0 = single, 1 = odd, 2 = even.
    callback set-spread(int);
    // Navigation (dir -1 = up/back, +1 = down/forward).
    callback nav-line(int);
    callback nav-page(int);
    callback nav-home();
    callback nav-end();
    // Paged-mode wheel: (delta-x, delta-y, shift). Rust scrolls within the page
    // and pages at the edges.
    callback paged-scroll(float, float, bool);

    // Paged view geometry, computed by Rust: where to place the current page's
    // content within the viewport, and the content's size.
    in property <length> paged-offset-x;
    in property <length> paged-offset-y;
    in property <length> paged-content-w;
    in property <length> paged-content-h;

    title: root.doc-title == "" ? "melkkipdf" : root.doc-title + " — melkkipdf";
    preferred-width: 1000px;
    preferred-height: 1000px;
    forward-focus: key-handler;

    property <length> view-w: content.width;
    property <length> view-h: content.height;
    changed view-w => { root.viewport-resized(root.view-w, root.view-h); }
    changed view-h => { root.viewport-resized(root.view-w, root.view-h); }

    key-handler := FocusScope {
        key-pressed(event) => {
            if (event.modifiers.control && (event.text == "+" || event.text == "=")) {
                root.zoom-in();
                return accept;
            }
            if (event.modifiers.control && event.text == "-") {
                root.zoom-out();
                return accept;
            }
            if (event.modifiers.control && event.text == "0") {
                root.zoom-reset();
                return accept;
            }
            if (event.text == "f") { root.fit-width(); return accept; }
            if (event.text == "p") { root.fit-page(); return accept; }
            if (event.text == "c") { root.toggle-continuous(); return accept; }
            if (event.text == "1") { root.set-spread(0); return accept; }
            if (event.text == "2") { root.set-spread(1); return accept; }
            if (event.text == "3") { root.set-spread(2); return accept; }
            if (event.text == Key.UpArrow) { root.nav-line(-1); return accept; }
            if (event.text == Key.DownArrow) { root.nav-line(1); return accept; }
            if (event.text == Key.LeftArrow) { root.nav-page(-1); return accept; }
            if (event.text == Key.RightArrow) { root.nav-page(1); return accept; }
            if (event.text == Key.PageUp) { root.nav-page(-1); return accept; }
            if (event.text == Key.PageDown || event.text == " ") { root.nav-page(1); return accept; }
            if (event.text == Key.Home) { root.nav-home(); return accept; }
            if (event.text == Key.End) { root.nav-end(); return accept; }
            return reject;
        }

        VerticalLayout {
            // Toolbar. Fixed height so its contents never reflow the layout.
            Rectangle {
                height: 44px;
                background: #333333;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 6px;

                    // Open a different PDF.
                    VerticalLayout {
                        alignment: center;
                        open-frame := Rectangle {
                            width: Toolbar.icon-size + 2 * Toolbar.h-padding;
                            height: 28px;
                            border-width: 1px;
                            border-color: #5a5a5a;
                            border-radius: 5px;
                            background: open-button.pressed
                                ? #252525
                                : (open-button.has-hover ? #505050 : #454545);
                            Image {
                                source: @image-url("icons/open.svg");
                                width: Toolbar.icon-size;
                                height: self.width;
                                colorize: open-button.pressed ? #ffffff : #dddddd;
                            }
                            open-button := TouchArea {
                                clicked => {
                                    root.open-document();
                                }
                            }
                        }
                    }

                    // Sidebar toggle (recessed while the sidebar is open).
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: Toolbar.icon-size + 2 * Toolbar.h-padding;
                            height: 28px;
                            border-width: 1px;
                            border-color: #5a5a5a;
                            border-radius: 5px;
                            background: (root.sidebar-open || sidebar-toggle.pressed)
                                ? #252525
                                : (sidebar-toggle.has-hover ? #505050 : #454545);
                            Image {
                                source: @image-url("icons/menu.svg");
                                width: Toolbar.icon-size;
                                height: self.width;
                                colorize: (root.sidebar-open || sidebar-toggle.pressed) ? #ffffff : #dddddd;
                            }
                            sidebar-toggle := TouchArea {
                                clicked => {
                                    root.toggle-sidebar();
                                }
                            }
                        }
                    }

                    // Action groups: `current: -1` so no segment stays selected;
                    // they just fire on click (with press feedback).
                    VerticalLayout {
                        alignment: center;
                        zoom-group := SegmentedControl {
                            options: [@image-url("icons/zoom-out.svg"), @image-url("icons/zoom-in.svg")];
                            current: -1;
                            select(index) => {
                                if (index == 0) {
                                    root.zoom-out();
                                } else {
                                    root.zoom-in();
                                }
                            }
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        fit-group := SegmentedControl {
                            labels: ["Page Fit", "Page Width"];
                            current: -1;
                            select(index) => {
                                if (index == 0) {
                                    root.fit-page();
                                } else {
                                    root.fit-width();
                                }
                            }
                        }
                    }

                    // Fused segmented toggles for the two mode groups.
                    VerticalLayout {
                        alignment: center;
                        SegmentedControl {
                            options: [@image-url("icons/continuous.svg"), @image-url("icons/paged.svg")];
                            current: root.continuous ? 0 : 1;
                            select(index) => {
                                root.set-continuous(index == 0);
                            }
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        spread-group := SegmentedControl {
                            options: [@image-url("icons/spread-single.svg"), @image-url("icons/spread-odd.svg"), @image-url("icons/spread-even.svg")];
                            current: root.spread-mode;
                            select(index) => {
                                root.set-spread(index);
                            }
                        }
                    }

                    // Spacer pushes the page counter to the right.
                    Rectangle { horizontal-stretch: 1; }

                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            spacing: 5px;
                            page-field := PageField {
                                page: root.current-page;
                                go-to(value) => {
                                    root.go-to-page(value);
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: "/ \{root.page-count}";
                                    color: #dddddd;
                                }
                            }
                        }
                    }
                }
            }

            HorizontalLayout {
                if root.sidebar-open: Rectangle {
                    width: 260px;
                    background: #2a2a2a;

                    VerticalLayout {
                        // Tab bar.
                        HorizontalLayout {
                            height: 34px;
                            Rectangle {
                                background: root.sidebar-tab == 0 ? #3a3a3a : #2a2a2a;
                                Text {
                                    text: "Outline";
                                    color: #dddddd;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                TouchArea {
                                    clicked => {
                                        root.sidebar-tab = 0;
                                    }
                                }
                            }
                            Rectangle {
                                background: root.sidebar-tab == 1 ? #3a3a3a : #2a2a2a;
                                Text {
                                    text: "Pages";
                                    color: #dddddd;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                TouchArea {
                                    clicked => {
                                        root.sidebar-tab = 1;
                                    }
                                }
                            }
                        }
                        Rectangle {
                            height: 1px;
                            background: #444444;
                        }

                        // Outline entries, indented by depth.
                        if root.sidebar-tab == 0: ListView {
                            for item in root.outline: Rectangle {
                                height: 26px;
                                background: outline-touch.has-hover ? #383838 : transparent;
                                HorizontalLayout {
                                    padding-left: 8px + item.depth * 14px;
                                    padding-right: 8px;
                                    Text {
                                        text: item.title;
                                        color: #cccccc;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                                outline-touch := TouchArea {
                                    clicked => {
                                        root.go-to-page-index(item.page);
                                    }
                                }
                            }
                        }

                        // Page thumbnails, grouped like the current spread mode.
                        if root.sidebar-tab == 1: ListView {
                            for entry[idx] in root.thumb-rows: Rectangle {
                                height: 160px;
                                background: thumb-touch.has-hover ? #333333 : transparent;
                                VerticalLayout {
                                    padding-top: 6px;
                                    spacing: 2px;
                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 4px;
                                        ThumbView {
                                            entry: entry.left;
                                        }
                                        if entry.has-right: ThumbView {
                                            entry: entry.right;
                                        }
                                    }
                                    Text {
                                        text: entry.has-right
                                            ? "\{entry.left.page + 1}–\{entry.right.page + 1}"
                                            : "\{entry.left.page + 1}";
                                        color: #999999;
                                        horizontal-alignment: center;
                                    }
                                }
                                thumb-touch := TouchArea {
                                    clicked => {
                                        root.go-to-page-index(entry.left.page);
                                    }
                                }
                                init => {
                                    root.request-thumbnail-row(idx);
                                }
                            }
                        }
                    }
                }

                content := Rectangle {
                    if root.page-count == 0: VerticalLayout {
                    alignment: center;
                    Text {
                        text: root.status;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }

                if root.page-count > 0 && root.continuous: ListView {
                    // Two-way bound so Rust can both read the scroll offset (for the
                    // page counter) and set it (to jump to a page).
                    viewport-y <=> root.scroll-y;
                    changed viewport-y => {
                        root.scrolled(-self.viewport-y / 1px);
                    }
                    for entry[idx] in root.rows: PageRowView {
                        page-row: entry;
                        density: root.density;
                        row-height-pt: root.row-height-pt;
                        // Request pixels when this row scrolls into view. Zoom
                        // re-renders are driven from Rust (rerender_loaded).
                        init => {
                            root.request-render-row(idx);
                        }
                    }
                }

                // Paged view: a Rust-controlled scroll surface. The wheel scrolls
                // within the page and pages at the edges; content is positioned
                // and sized by Rust so centering, scrolling, and shift-to-scroll-
                // horizontally are all deterministic.
                if root.page-count > 0 && !root.continuous: TouchArea {
                    scroll-event(event) => {
                        root.paged-scroll(event.delta-x / 1px, event.delta-y / 1px, event.modifiers.shift);
                        return accept;
                    }
                    Rectangle {
                        clip: true;
                        Rectangle {
                            x: root.paged-offset-x;
                            y: root.paged-offset-y;
                            width: root.paged-content-w;
                            height: root.paged-content-h;

                            HorizontalLayout {
                                spacing: 4px;
                                PageImageView {
                                    entry: root.current-row-content.left;
                                    density: root.density;
                                }
                                if root.current-row-content.has-right: PageImageView {
                                    entry: root.current-row-content.right;
                                    density: root.density;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
}
