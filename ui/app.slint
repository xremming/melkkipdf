import { ListView, ScrollView, Spinner } from "std-widgets.slint";

// Shared toolbar metrics, so the standalone buttons and the segmented controls
// give their icons the same breathing room. Exported for the layout tests.
export global Toolbar {
    out property <length> icon-size: 18px;
    out property <length> h-padding: 16px;
}

// How pages are spaced. The viewer reads these for its scroll and fit math,
// so they are defined here once and the two cannot drift apart.
export global PageLayout {
    // The gap between rows in continuous mode, half above the pages and half
    // below, as part of each row's height.
    out property <length> row-gap: 16px;
    // The gap between the two pages of a spread.
    out property <length> spread-spacing: 4px;
}

// An area of a page to highlight, such as a search hit, in points from the
// page's top-left corner. `current` marks the hit the reader is on.
export struct Highlight {
    x: float,
    y: float,
    width: float,
    height: float,
    current: bool,
}

// One page's fixed size (in PDF points) and its rendered image. The image is
// empty until the page has been rendered, and stays empty if rendering failed.
// `highlights` are the search hits on the page and `selection` the parts of
// the text the reader has selected, both in points.
export struct PageEntry {
    page: int,
    width-pt: float,
    height-pt: float,
    image: image,
    failed: bool,
    highlights: [Highlight],
    selection: [Highlight],
}

// One search hit in the results list: its 0-based page, and the text found
// with some of the text before and after it. `page-hits` is how many hits its
// page has on the page's first hit, and 0 on the rest, so the list heads each
// page's hits once. `headings` is how many page headings the list has down to
// and including this hit's own, so the list can tell where the hit sits.
export struct SearchResult {
    page: int,
    page-hits: int,
    headings: int,
    before: string,
    found: string,
    after: string,
}

// A row in the document: a single page, or two pages side by side (a spread).
// When `has-right` is false, `right` is unused. `scale` shrinks a row far larger
// than the document's usual one, such as a fold-out map, so it fits the height
// every row in the continuous view shares; it is 1 for every other row.
export struct PageRow {
    left: PageEntry,
    right: PageEntry,
    has-right: bool,
    scale: float,
}

// One entry in the document outline (table of contents).
export struct OutlineItem {
    title: string,
    page: int,
    depth: int,
}

// A page the reader has flagged: the 0-based page its flag sits at on the
// page edge, the colour the flag was given and its hue in degrees, which
// names it among the palette's colours, and what its tooltip says.
export struct BookmarkFlag {
    page: int,
    color: color,
    hue: int,
    // Its shape, as an index into the window's `shapes`.
    shape: int,
    label: string,
}

// A colour a flag can be given, from the flag's menu: its name, its hue in
// degrees, and a swatch of it for the menu.
export struct FlagColor {
    name: string,
    hue: int,
    swatch: image,
}

// A shape a flag can be given, from the flag's menu: its name, its index,
// and a picture of it for the menu.
export struct FlagShape {
    name: string,
    shape: int,
    icon: image,
}

// A single page: white paper with the rendered image on top. Sized from the
// page's points times the shared density.
component PageImageView inherits Rectangle {
    in property <PageEntry> entry;
    in property <float> density;
    // The reader pressed on, dragged over, or let go of the page's text.
    // The point is in points from the page's top-left corner, and while a
    // drag goes on it is measured from the page it began on, which can put
    // it outside that page.
    callback select-from(/* page */ int, /* x-pt */ float, /* y-pt */ float);
    callback select-to(int, float, float);
    callback select-done();
    // The wheel turned while a drag was going on, which the drag would
    // otherwise swallow (delta-x, delta-y, shift).
    callback select-scroll(float, float, bool);
    callback copy-selection();
    callback select-all();
    width: entry.width-pt * density * 1px;
    height: entry.height-pt * density * 1px;
    background: white;
    Image {
        source: entry.image;
        width: 100%;
        height: 100%;
    }

    // Search hits, drawn over the page, the one the reader is on stronger.
    for highlight in entry.highlights: Rectangle {
        x: highlight.x * density * 1px;
        y: highlight.y * density * 1px;
        width: highlight.width * density * 1px;
        height: highlight.height * density * 1px;
        background: highlight.current ? #ff8c0080 : #ffd24d66;
    }

    // The selected text.
    for area in entry.selection: Rectangle {
        x: area.x * density * 1px;
        y: area.y * density * 1px;
        width: area.width * density * 1px;
        height: area.height * density * 1px;
        background: #3390ff66;
    }

    page-menu := ContextMenuArea {
        Menu {
            MenuItem {
                title: "Copy";
                activated => {
                    root.copy-selection();
                }
            }
            MenuItem {
                title: "Select all";
                activated => {
                    root.select-all();
                }
            }
        }
    }

    // Sits over the menu area, so it opens the menu itself on a right
    // click. Wheel events it has no use for go on to the view underneath,
    // except while a drag holds the pointer, when they are passed on by hand.
    touch := TouchArea {
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.select-from(entry.page, self.mouse-x / (root.density * 1px), self.mouse-y / (root.density * 1px));
            }
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up) {
                root.select-done();
            }
            if (event.kind == PointerEventKind.cancel) {
                root.select-done();
            }
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                page-menu.show({ x: self.mouse-x, y: self.mouse-y });
            }
        }
        moved => {
            if (self.pressed) {
                root.select-to(entry.page, self.mouse-x / (root.density * 1px), self.mouse-y / (root.density * 1px));
            }
        }
        scroll-event(event) => {
            if (self.pressed) {
                root.select-scroll(event.delta-x / 1px, event.delta-y / 1px, event.modifiers.shift);
                return accept;
            }
            return reject;
        }
    }

    // A spinner while the page has not been rendered yet (empty image). It
    // disappears as soon as the rendered image arrives.
    if entry.image.width == 0 && !entry.failed: Spinner {
        width: min(36px, parent.width / 4);
        height: self.width;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        indeterminate: true;
    }

    // A page that failed to render says so, rather than spinning forever.
    if entry.failed: Text {
        width: parent.width - 16px;
        text: "This page could not be displayed.";
        color: #666666;
        horizontal-alignment: center;
        vertical-alignment: center;
        wrap: word-wrap;
    }
}

// A single fixed-size page thumbnail for the sidebar. The image is letterboxed
// into a uniform box so every thumbnail row is the same height (which the
// sidebar ListView needs for stable scrolling).
component ThumbView inherits Rectangle {
    in property <PageEntry> entry;
    width: 96px;
    height: 128px;
    background: white;
    border-width: 1px;
    border-color: #555555;

    Image {
        source: entry.image;
        width: 100%;
        height: 100%;
        image-fit: contain;
    }

    if entry.image.width == 0 && !entry.failed: Spinner {
        width: 24px;
        height: 24px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        indeterminate: true;
    }
}

// One row, centered horizontally and vertically. A single page centers on its
// own; a spread centers as a pair so the two pages meet at the middle.
//
// Every row reserves the same height (`row-height-pt`, the tallest of the
// document's usual rows, with larger rows scaled down to it). Slint's ListView
// assumes uniform item heights when estimating the scroll extent; giving it
// exactly that keeps the viewport anchor stable while scrolling instead of
// oscillating, which otherwise triggers a long instantiation-chain warning.
component PageRowView inherits Rectangle {
    in property <PageRow> page-row;
    in property <float> density;
    in property <float> row-height-pt;
    // Passed up from the pages (see PageImageView).
    callback select-from(int, float, float);
    callback select-to(int, float, float);
    callback select-done();
    callback select-scroll(float, float, bool);
    callback copy-selection();
    callback select-all();
    height: row-height-pt * density * 1px + PageLayout.row-gap;
    background: #2b2b2b;

    HorizontalLayout {
        alignment: center;
        spacing: PageLayout.spread-spacing;

        VerticalLayout {
            alignment: center;
            PageImageView {
                entry: page-row.left;
                density: root.density * page-row.scale;
                select-from(page, x, y) => { root.select-from(page, x, y); }
                select-to(page, x, y) => { root.select-to(page, x, y); }
                select-done => { root.select-done(); }
                select-scroll(dx, dy, shift) => { root.select-scroll(dx, dy, shift); }
                copy-selection => { root.copy-selection(); }
                select-all => { root.select-all(); }
            }
        }
        if page-row.has-right: VerticalLayout {
            alignment: center;
            PageImageView {
                entry: page-row.right;
                density: root.density * page-row.scale;
                select-from(page, x, y) => { root.select-from(page, x, y); }
                select-to(page, x, y) => { root.select-to(page, x, y); }
                select-done => { root.select-done(); }
                select-scroll(dx, dy, shift) => { root.select-scroll(dx, dy, shift); }
                copy-selection => { root.copy-selection(); }
                select-all => { root.select-all(); }
            }
        }
    }
}

// One segment of a fused segmented control. The active segment is recessed
// (darker) so it reads as pressed in. Its content is tinted to match the state.
// Carries an icon, or a text label where pdf.js has no icon to borrow.
component Segment inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    // Shown while the pointer rests on the segment.
    in property <string> tip;
    in property <bool> active;
    in property <bool> divider;
    // Slint has no minimum-padding property, but an inner layout is the same
    // thing: its padding is part of the segment's minimum width, so this is the
    // narrowest gap the content can ever get, and a wider segment just centers
    // the content in the extra space.
    in property <length> h-padding;
    callback clicked <=> touch.clicked;

    // Recessed while selected (radio use) or held down (action use).
    background: (root.active || touch.pressed)
        ? #252525
        : (touch.has-hover ? #505050 : #454545);
    property <brush> tint: (root.active || touch.pressed) ? #ffffff : #b8b8b8;

    HorizontalLayout {
        alignment: center;
        padding-left: root.h-padding;
        padding-right: root.h-padding;

        // The icon is a fixed size, which a HorizontalLayout would otherwise pin
        // to the top of the segment, so center it on the cross axis by hand.
        if root.label == "": VerticalLayout {
            alignment: center;
            icon-image := Image {
                source: root.icon;
                width: Toolbar.icon-size;
                height: self.width;
                // The source icons are solid black, so colorize carries the tint.
                colorize: root.tint;
            }
        }

        if root.label != "": label-text := Text {
            text: root.label;
            color: root.tint;
            font-size: 13px;
            vertical-alignment: center;
        }
    }

    // Divider between segments (drawn on the left edge of all but the first).
    if root.divider: Rectangle {
        x: 0;
        width: 1px;
        background: #5a5a5a;
    }

    touch := TouchArea { }

    Tooltip {
        text: @markdown("\{root.tip}");
    }
}

// A fused, segmented toggle: the options render as one control with rounded ends
// and shared borders. Emits `select` with the chosen index. A control fills
// either `options` (icons) or `labels` (text), never both, and `tips` has a
// tooltip for each segment.
component SegmentedControl inherits Rectangle {
    in property <[image]> options;
    in property <[string]> labels;
    in property <[string]> tips;
    in property <int> current;
    // Guaranteed gap on each side of every segment's icon or label, which is
    // what sizes the control now that it hugs its content.
    in property <length> segment-padding: Toolbar.h-padding;
    callback select(int);

    height: 28px;
    // A Rectangle has no natural width, so without this the control would
    // stretch to fill the toolbar instead of hugging its segments.
    horizontal-stretch: 0;
    border-width: 1px;
    border-color: #5a5a5a;
    border-radius: 5px;
    // Clip so the square-cornered segments are rounded off at the ends.
    clip: true;

    HorizontalLayout {
        for option[idx] in root.options: Segment {
            icon: option;
            tip: root.tips[idx];
            active: idx == root.current;
            divider: idx > 0;
            h-padding: root.segment-padding;
            clicked => {
                root.select(idx);
            }
        }
        for text[idx] in root.labels: Segment {
            label: text;
            tip: root.tips[idx];
            active: idx == root.current;
            divider: idx > 0;
            h-padding: root.segment-padding;
            clicked => {
                root.select(idx);
            }
        }
    }
}

// An editable page-number field. Shows the current page and, on Enter, emits the
// typed text for the viewer to jump to. Styled to match the dark toolbar.
component PageField inherits Rectangle {
    in property <int> page;
    callback go-to(string);
    // The cursor is leaving the field, whether a page was asked for or not.
    callback done();

    // Puts the cursor in the field with the number selected, so typing
    // replaces it.
    public function take-focus() {
        input.focus();
        input.select-all();
    }

    width: 48px;
    height: 26px;
    border-width: 1px;
    border-color: #5a5a5a;
    border-radius: 4px;
    background: #2b2b2b;

    input := TextInput {
        width: 100%;
        height: 100%;
        // One-way binding: user edits persist until `page` changes externally
        // (scroll/nav), which then refreshes the field.
        text: "\{root.page}";
        color: #eeeeee;
        font-size: 14px;
        horizontal-alignment: center;
        vertical-alignment: center;
        single-line: true;
        input-type: number;
        accepted => {
            root.go-to(self.text);
            root.done();
        }
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.done();
                return accept;
            }
            return reject;
        }
    }
}

// One browser-style tab: the document's name and a button that closes it. The
// active tab takes the toolbar's colour, so it reads as joined to the toolbar
// below it, as a browser's tab does to its address bar.
//
// A tab can be dragged along the strip to reorder it. The strip decides where
// it lands, so the tab only reports how far it has been dragged and when it is
// let go, and draws itself `offset` away from its place while the others make
// room for it.
component DocumentTab inherits Rectangle {
    in property <string> title;
    in property <bool> active;
    // How far the tab is drawn from its place in the strip.
    in property <length> offset;
    // Whether the offset follows the pointer, rather than easing into place
    // as a tab making room for a dragged one does.
    in property <bool> lifted;
    // Whether any tab of the strip is being dragged. Only then do tabs ease
    // into place: once one is dropped, they are already where they belong.
    in property <bool> reordering;
    callback clicked();
    callback close();
    // How far the pointer has moved along the strip since the tab was pressed.
    callback dragged(length);
    callback dropped();
    callback drag-cancelled();

    // Tabs share the strip like a browser's: as wide as a title needs up to a
    // cap, then narrowing together as more open. No minimum, so a long row of
    // tabs never forces the window wider than the screen.
    min-width: 0;
    preferred-width: 220px;
    max-width: 220px;
    horizontal-stretch: 1;

    // The tab hangs from the toolbar like a browser's, so its face leaves the
    // top of the strip clear rather than the strip padding it, and the
    // buttons beside the tabs centre on the whole strip.
    property <length> top-gap: 6px;

    // Stays in the tab's place while the face moves, so the distance dragged
    // is measured from where the tab was pressed. Declared before the face so
    // the close button, drawn on top, gets its own clicks.
    touch := TouchArea {
        y: root.top-gap;
        height: root.height - root.top-gap;
        // Only the left button drags, and only once it has moved far enough
        // that a click with a shaky hand still just selects the tab.
        property <bool> left-down;
        property <bool> dragging;

        pointer-event(event) => {
            if (event.kind == PointerEventKind.cancel) {
                if (self.dragging) {
                    root.drag-cancelled();
                }
                self.left-down = false;
                self.dragging = false;
            }
            if (event.button == PointerEventButton.left) {
                // A tab is selected as soon as it is pressed, as in a
                // browser, so the one being dragged is the one shown.
                if (event.kind == PointerEventKind.down) {
                    self.left-down = true;
                    root.clicked();
                }
                if (event.kind == PointerEventKind.up) {
                    if (self.dragging) {
                        root.dropped();
                    }
                    self.left-down = false;
                    self.dragging = false;
                }
            }
            // A middle click closes a tab in every browser.
            if (event.button == PointerEventButton.middle && event.kind == PointerEventKind.up) {
                root.close();
            }
        }
        moved => {
            if (self.left-down && !self.dragging && abs(self.mouse-x - self.pressed-x) > 5px) {
                self.dragging = true;
            }
            if (self.dragging) {
                root.dragged(self.mouse-x - self.pressed-x);
            }
        }
    }

    face := Rectangle {
        x: root.lifted ? root.offset : eased-offset;
        y: root.top-gap;
        width: root.width;
        height: root.height - root.top-gap;
        clip: true;
        border-top-left-radius: 6px;
        border-top-right-radius: 6px;
        background: root.active ? #333333 : (touch.has-hover ? #2e2e2e : transparent);

        property <length> eased-offset: root.offset;
        animate eased-offset {
            duration: 150ms;
            easing: ease-out;
            enabled: root.reordering;
        }

        HorizontalLayout {
            padding-left: 12px;
            padding-right: 6px;
            spacing: 4px;

            tab-title := Text {
                text: root.title;
                color: root.active ? #eeeeee : #aaaaaa;
                font-size: 13px;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }

            VerticalLayout {
                alignment: center;
                close-button := Rectangle {
                    width: 18px;
                    height: 18px;
                    border-radius: 3px;
                    background: close-touch.has-hover ? #555555 : transparent;
                    Path {
                        width: 8px;
                        height: 8px;
                        viewbox-width: 8;
                        viewbox-height: 8;
                        commands: "M 0 0 L 8 8 M 8 0 L 0 8";
                        stroke: root.active || close-touch.has-hover ? #dddddd : #999999;
                        stroke-width: 1.5px;
                    }
                    close-touch := TouchArea {
                        clicked => {
                            root.close();
                        }
                    }
                }
            }
        }
    }
}

// Top-level window: a toolbar above the document, shown either as a continuous
// scrollable column of rows or one row at a time.
// One line of the help page: the keys on the left, what they do on the
// right.
component HelpRow inherits HorizontalLayout {
    in property <string> keys;
    in property <string> action;
    spacing: 12px;
    Text {
        text: root.keys;
        color: #ffffff;
        font-size: 13px;
        width: 135px;
        vertical-alignment: top;
    }
    Text {
        text: root.action;
        color: #bbbbbb;
        font-size: 13px;
        wrap: word-wrap;
        horizontal-stretch: 1;
    }
}

// A titled group of help rows.
component HelpSection inherits VerticalLayout {
    in property <string> title;
    spacing: 4px;
    Text {
        text: root.title;
        color: #ffffff;
        font-size: 13px;
        font-weight: 700;
    }
    @children
}

export component MainWindow inherits Window {
    in property <[PageRow]> rows;
    in property <PageRow> current-row-content;
    in property <bool> continuous: true;
    in property <float> density: 1.333;
    in property <float> row-height-pt: 1.0;
    // Spread mode for the toolbar radios: 0 = single, 1 = odd, 2 = even.
    in property <int> spread-mode;
    // 1-based page currently at the top of the view, and total page count.
    in property <int> current-page;
    in property <int> page-count;
    // Two-way bound to the ListView's scroll offset so Rust can jump to a page.
    in-out property <length> scroll-y;
    // Shown in the document area while no document is open.
    in property <string> status;
    // A problem to tell the reader about, such as a document or page that
    // failed to open, shown over the document until dismissed or replaced.
    // Empty while there is nothing to report.
    in-out property <string> notice;

    // Sidebar: the document outline, thumbnail rows (grouped like the current
    // spread mode), and which tab is showing (0 = outline, 1 = pages).
    in property <[OutlineItem]> outline;
    in property <[PageRow]> thumb-rows;
    in-out property <bool> sidebar-open: true;
    in-out property <int> sidebar-tab;

    // The reader's bookmarks, drawn as flags on the page edge, and the
    // 0-based page Tab flips back to (-1 while there is none).
    in property <[BookmarkFlag]> bookmarks;
    in property <int> return-page: -1;
    // The colours and the shapes a flag's menu offers.
    in property <[FlagColor]> palette;
    in property <[FlagShape]> shapes;
    // How far a flag's end is cut into or out to, and the radius of a tab's
    // corners.
    property <length> flag-cut: 5px;
    property <length> flag-corner: 3px;
    // A pixel of the display, in logical pixels, from Rust: 1 on a plain
    // screen and 0.5 on one at 2x.
    in property <float> device-pixel: 1;
    // How tall the shaped end of a flag `w` by `h` is, by its shape (see
    // `shapes`): the cut of a pennant or an arrow, the corners of a tab, or
    // the largest half-round the flag has room for. The rest of the flag is
    // a plain rectangle, which the renderer draws to the pixel, and only the
    // end is a path, whose anti-aliased edges it softens a little past the
    // geometry and, at a corner, unevenly; so the end is drawn `inset` in
    // from the flag's sides to land on them, and starts a pixel up under
    // the rectangle, which hides its top edge.
    pure function flag-end(shape: int, w: float, h: float, inset: float) -> float {
        if (shape == 1 || shape == 2) {
            return root.flag-cut / 1px;
        }
        if (shape == 3) {
            return min((w - 2 * inset) / 2, h / 2);
        }
        return root.flag-corner / 1px;
    }
    pure function flag-path(shape: int, w: float, h: float, inset: float) -> string {
        let x0 = inset;
        let x1 = w - inset;
        let y1 = h - inset;
        let y0 = y1 - root.flag-end(shape, w, h, inset) - 1;
        let mid = w / 2;
        if (shape == 1) {
            return "M \{x0} \{y0} L \{x1} \{y0} L \{x1} \{y1} L \{mid} \{y1 - root.flag-end(shape, w, h, inset)} L \{x0} \{y1} Z";
        }
        if (shape == 2) {
            return "M \{x0} \{y0} L \{x1} \{y0} L \{x1} \{y1 - root.flag-end(shape, w, h, inset)} L \{mid} \{y1} L \{x0} \{y1 - root.flag-end(shape, w, h, inset)} Z";
        }
        let r = root.flag-end(shape, w, h, inset);
        return "M \{x0} \{y0} L \{x1} \{y0} L \{x1} \{y1 - r} A \{r} \{r} 0 0 1 \{x1 - r} \{y1} L \{x0 + r} \{y1} A \{r} \{r} 0 0 1 \{x0} \{y1 - r} Z";
    }

    // The help page over the window, with every shortcut. The modifier it
    // names is Cmd on macOS, where Slint reports it as control, and Ctrl
    // elsewhere.
    in-out property <bool> help-open;
    property <string> command-key: Platform.os == OperatingSystemType.macos ? "⌘" : "Ctrl+";

    // Shows the help, or puts it away, and leaves the keys with the
    // document either way, since the help is read, not typed into.
    function toggle-help() {
        root.help-open = !root.help-open;
        key-handler.focus();
    }
    // Flags the page being read, or takes its flag away.
    callback toggle-bookmark();
    // Takes the flag off a 0-based page.
    callback remove-bookmark(int);
    // Gives the flag on a 0-based page the colour of a hue in degrees, or
    // the shape at an index into `shapes`.
    callback color-bookmark(int, int);
    callback shape-bookmark(int, int);
    // Jumps to a flagged 0-based page, remembering where it was left from.
    callback go-to-bookmark(int);
    // Jumps to the next (1) or previous (-1) flag, wrapping around.
    callback bookmark-step(int);
    // Flips back to where the last bookmark jump was left from.
    callback flip-back();
    // Puts the dog-ear on the page being read, for Tab to come back to.
    callback mark-return-page();
    // The strip above the pages that the flags hang from: its edge line,
    // the bar for the page being read, and a pixel between that and the
    // pages.
    property <length> edge-height: 5px;
    // Where a flag on a 0-based page sits along a page edge `width` wide
    // whose left is `origin` from the window's: at the page's depth, at
    // least wide enough to hit, and the last one kept whole. Only meaningful
    // while a document is open. On whole pixels of the window: a flag is a
    // path, drawn anti-aliased, and the bar over it a rectangle, drawn
    // without, and on half a pixel the two come out a pixel apart.
    pure function flag-width(width: length) -> length {
        return round(max(12px, width / root.page-count) / 1px) * 1px;
    }
    pure function flag-x(page: int, width: length, origin: length) -> length {
        let x = max(0px, min(width - root.flag-width(width), page * width / root.page-count));
        return round((origin + x) / 1px) * 1px - origin;
    }

    // The name of the open document, shown in the window title bar.
    in property <string> doc-title;

    // Whether files dragged from another application are over the window.
    in property <bool> drop-hover;

    // The search sidebar on the right: whether it is open, the query, a line
    // saying how the search went, the hits, and the index of the one the
    // reader is on (-1 for none).
    in-out property <bool> search-open;
    in-out property <string> search-text;
    // What the search looks for: 0 for every place the query's text occurs,
    // 1 for the pages most like it in meaning.
    in-out property <int> search-mode: 0;
    in property <string> search-status;
    in property <[SearchResult]> search-results;
    in property <int> search-current: -1;
    // The query was edited.
    callback search-edited(string);
    // The reader picked what the search looks for (see `search-mode`).
    callback search-mode-changed(int);
    // Move to the next (+1) or previous (-1) hit.
    callback search-step(int);
    // Move to a hit picked from the results list, by its index there.
    callback go-to-search-result(int);
    // Invoked from Rust when a document's indexer has read more pages, so
    // the app can take them in.
    callback text-indexed();
    // Invoked from Rust when a document's vectorizer has made more page
    // vectors, so the app can take them in.
    callback pages-vectorized();

    // Picks what the search looks for, as a press on the switch does.
    function set-search-mode(mode: int) {
        if (root.search-mode != mode) {
            root.search-mode = mode;
            root.search-mode-changed(mode);
        }
    }

    // Setting the text from here does not count as an edit, so the app is
    // told the query is empty the way typing would tell it.
    function clear-search() {
        root.search-text = "";
        root.search-edited("");
        search-input.focus();
    }

    // The heights of a hit's row in the results list, of a page's heading
    // above its first hit, and of the gap above every heading but the first.
    property <length> search-row-height: 24px;
    property <length> search-heading-height: 16px;
    property <length> search-heading-gap: 6px;

    // Keeps the current hit, with its page's heading if it has one, in view
    // in the results list. The list only builds the rows it shows, so where
    // the hit sits is worked out from the headings above it.
    changed search-current => {
        if (root.search-current >= 0 && root.search-current < root.search-results.length) {
            let result = root.search-results[root.search-current];
            let bottom = (root.search-current + 1) * root.search-row-height
                + result.headings * root.search-heading-height
                + (result.headings - 1) * root.search-heading-gap;
            let top = bottom - root.search-row-height
                - (result.page-hits > 0 ? root.search-heading-height : 0px);
            let view-bottom = search-list.visible-height - search-list.content-y;
            if (top < -search-list.content-y) {
                search-list.content-y = -top;
            } else if (top > view-bottom + search-list.visible-height) {
                // A hit more than a screen below goes to the top rather than
                // the bottom. The list places a far-off row by the average
                // height of the rows it has built, rounded down, so a row
                // meant for the bottom edge can land just past it, while one
                // meant for the top lands there or a little below.
                search-list.content-y = -top;
            } else if (bottom > view-bottom) {
                search-list.content-y = search-list.visible-height - bottom;
            }
        }
    }

    // Opening the search sidebar puts the cursor in its field, and closing
    // it hands the keys back to the document.
    function toggle-search() {
        root.search-open = !root.search-open;
        if (root.search-open) {
            root.focus-search();
        } else {
            key-handler.focus();
        }
    }

    // Puts the cursor in the search field with the query selected, so typing
    // replaces it.
    function focus-search() {
        search-input.focus();
        search-input.select-all();
    }

    // One title per open document, in tab order, and the index of the tab
    // shown (-1 while nothing is open).
    in property <[string]> tabs;
    in property <int> active-tab: -1;

    // The tab being dragged along the strip (-1 while none is), how far it
    // has been dragged, the distance from one tab to the next, and the place
    // it would land if let go now.
    property <int> dragged-tab: -1;
    property <length> tab-drag-x;
    property <length> tab-stride;
    property <int> tab-drop-index: root.dragged-tab < 0 || root.tab-stride <= 0
        ? root.dragged-tab
        : max(0, min(root.tabs.length - 1, root.dragged-tab + round(root.tab-drag-x / root.tab-stride)));

    // Open a new PDF in a new tab (prompts for a file with a native picker).
    callback open-document();
    callback select-tab(int);
    callback close-tab(int);
    // Moves the tab at the first index to the second, shifting the ones
    // between over by one.
    callback move-tab(int, int);
    callback toggle-sidebar();
    // Jump to a 0-based page (from the outline or a thumbnail).
    callback go-to-page-index(int);
    // A visible thumbnail row wants its pages rendered (row index).
    callback request-thumbnail-row(int);
    // Invoked from Rust when a page thumbnail has rendered (document id, page
    // index, image). Every tab's worker reports here, hence the document id.
    callback thumbnail-rendered(int, int, image);
    callback request-render-row(int);
    // Invoked from Rust when a page has rendered (document id, page, the scale
    // it was asked for at, image).
    callback page-rendered(int, int, float, image);
    // Invoked from Rust when a page failed to render (document id, page), or
    // its thumbnail failed to.
    callback page-failed(int, int);
    callback thumbnail-failed(int, int);
    // Invoked from Rust with a problem to show the reader.
    callback notify(string);
    // Invoked from Rust when a document's worker has finished reading it, so
    // the app can take in what it read.
    callback document-loaded();
    // Invoked from Rust when another instance has been asked to open
    // documents, so the app can open them here instead.
    callback documents-requested();
    callback viewport-resized(length, length);
    // Continuous scroll offset changed (logical pixels from the top).
    callback scrolled(float);
    // The reader scrolled the continuous list themselves, as opposed to the
    // offset changing because the viewer set it or the list laid itself out.
    callback user-scrolled();
    callback zoom-in();
    callback zoom-out();
    callback zoom-reset();
    callback fit-width();
    callback fit-page();
    callback set-continuous(bool);
    callback toggle-continuous();
    // Jump to a page from the toolbar field (raw text, parsed in Rust).
    callback go-to-page(string);
    // Spread mode: 0 = single, 1 = odd, 2 = even.
    callback set-spread(int);
    // Navigation (dir -1 = up/back, +1 = down/forward).
    callback nav-line(int);
    callback nav-page(int);
    callback nav-home();
    callback nav-end();
    // Paged-mode wheel: (delta-x, delta-y, shift). Rust scrolls within the page
    // and pages at the edges.
    callback paged-scroll(float, float, bool);

    // Selecting text: the reader pressed on a 0-based page at a point in
    // points from its corner, dragged to a point measured from that same
    // page, and let go; the wheel turned during the drag (delta-x, delta-y,
    // shift); and the selection is to be copied, cleared, or made the whole
    // document.
    callback select-from(int, float, float);
    callback select-to(int, float, float);
    callback select-done();
    callback select-scroll(float, float, bool);
    callback copy-selection();
    callback clear-selection();
    callback select-all();
    // A press on a page starts a selection, and hands the keys back to the
    // document from the search field the way a click on the view does.
    function page-pressed(page: int, x: float, y: float) {
        key-handler.focus();
        root.select-from(page, x, y);
    }

    // Paged view geometry, computed by Rust: where to place the current page's
    // content within the viewport, and the content's size.
    in property <length> paged-offset-x;
    in property <length> paged-offset-y;
    in property <length> paged-content-w;
    in property <length> paged-content-h;

    title: root.doc-title == "" ? "melkkipdf" : root.doc-title + " — melkkipdf";
    preferred-width: 1000px;
    preferred-height: 1000px;
    forward-focus: key-handler;

    property <length> view-w: content.width;
    property <length> view-h: content.height;
    changed view-w => { root.viewport-resized(root.view-w, root.view-h); }
    changed view-h => { root.viewport-resized(root.view-w, root.view-h); }

    key-handler := FocusScope {
        key-pressed(event) => {
            // ? and F1 show the help, and Esc or either key puts it away.
            // Nothing else gets through while it is up, so the document
            // stays put underneath.
            if (event.text == "?" || event.text == Key.F1) {
                root.toggle-help();
                return accept;
            }
            if (root.help-open) {
                if (event.text == Key.Escape) {
                    root.help-open = false;
                }
                return accept;
            }
            // Selected text: Ctrl+C copies it, Ctrl+A selects the whole
            // document, and Esc lets it go.
            if (event.modifiers.control && (event.text == "c" || event.text == "C")) {
                root.copy-selection();
                return accept;
            }
            if (event.modifiers.control && (event.text == "a" || event.text == "A")) {
                root.select-all();
                return accept;
            }
            if (event.text == Key.Escape) {
                root.clear-selection();
                return accept;
            }
            if (event.modifiers.control && (event.text == "+" || event.text == "=")) {
                root.zoom-in();
                return accept;
            }
            if (event.modifiers.control && event.text == "-") {
                root.zoom-out();
                return accept;
            }
            if (event.modifiers.control && event.text == "0") {
                root.zoom-reset();
                return accept;
            }
            // Ctrl+Shift+F switches the search between exact and by meaning,
            // opening the sidebar with the cursor in the field if need be.
            // Before Ctrl+F, which would take the shifted key as its own.
            if (event.modifiers.control && event.modifiers.shift && (event.text == "f" || event.text == "F")) {
                root.set-search-mode(root.search-mode == 0 ? 1 : 0);
                if (!search-input.has-focus) {
                    root.search-open = true;
                    root.focus-search();
                }
                return accept;
            }
            // Ctrl+F puts the cursor in the search field with the query
            // selected, opening the sidebar if need be, and closes the sidebar
            // again from the field. Once Esc has left the field, it goes back
            // to it rather than closing.
            if (event.modifiers.control && (event.text == "f" || event.text == "F")) {
                if (search-input.has-focus) {
                    root.toggle-search();
                } else {
                    root.search-open = true;
                    root.focus-search();
                }
                return accept;
            }
            // Browser tab shortcuts: Ctrl+W closes the tab, Ctrl+1 to Ctrl+8
            // show the tab with that number and Ctrl+9 the last one, and
            // Ctrl+Tab and Ctrl+Shift+Tab cycle through the tabs. On macOS the
            // first two use Cmd, which Slint reports as control there, but
            // cycling keeps Ctrl, reported as meta, as Cmd+Tab switches apps.
            if (event.modifiers.control && (event.text == "w" || event.text == "W")) {
                if (root.active-tab >= 0) {
                    root.close-tab(root.active-tab);
                }
                return accept;
            }
            if (event.modifiers.control && (event.text == "o" || event.text == "O")) {
                root.open-document();
                return accept;
            }
            if (event.modifiers.control && event.text.character-count == 1 && event.text.is-float()) {
                let number = event.text.to-float();
                if (number == 9 && root.tabs.length > 0) {
                    root.select-tab(root.tabs.length - 1);
                } else if (number <= root.tabs.length) {
                    root.select-tab(number - 1);
                }
                return accept;
            }
            let cycle-modifier = Platform.os == OperatingSystemType.macos
                ? event.modifiers.meta
                : event.modifiers.control;
            if (cycle-modifier && (event.text == Key.Tab || event.text == Key.Backtab)) {
                if (root.tabs.length > 1) {
                    if (event.modifiers.shift || event.text == Key.Backtab) {
                        root.select-tab(Math.mod(root.active-tab + root.tabs.length - 1, root.tabs.length));
                    } else {
                        root.select-tab(Math.mod(root.active-tab + 1, root.tabs.length));
                    }
                }
                return accept;
            }
            // The rest are single keys, laid out as in Vim and zathura so
            // the viewer reads well from the keyboard alone. Zoom and the
            // fits: + and - zoom, = is 100%, S fits the width and A the
            // whole page.
            if (event.text == "+") { root.zoom-in(); return accept; }
            if (event.text == "-") { root.zoom-out(); return accept; }
            if (event.text == "=") { root.zoom-reset(); return accept; }
            if (event.text == "s") { root.fit-width(); return accept; }
            if (event.text == "a") { root.fit-page(); return accept; }
            if (event.text == "c") { root.toggle-continuous(); return accept; }
            if (event.text == "1") { root.set-spread(0); return accept; }
            if (event.text == "2") { root.set-spread(1); return accept; }
            if (event.text == "3") { root.set-spread(2); return accept; }
            // Search: / puts the cursor in the field like Ctrl+F, and N and
            // Shift+N step through the hits without leaving the document.
            if (event.text == "/") {
                root.search-open = true;
                root.focus-search();
                return accept;
            }
            if (event.text == "n") { root.search-step(1); return accept; }
            if (event.text == "N") { root.search-step(-1); return accept; }
            // Bookmarks: D flags the page, B and Shift+B flip to the next and
            // previous flag, M sets the dog-ear on the page, and Tab flips
            // back to it, or to where the last flip came from. Tab is
            // otherwise free here: the fields are reached with keys of their
            // own or a click, not by tabbing.
            if (event.text == "d") { root.toggle-bookmark(); return accept; }
            if (event.text == "b") { root.bookmark-step(1); return accept; }
            if (event.text == "B") { root.bookmark-step(-1); return accept; }
            if (event.text == "m") { root.mark-return-page(); return accept; }
            if (event.text == Key.Tab) { root.flip-back(); return accept; }
            // O opens a document and T shows or hides the sidebar, and a
            // colon puts the cursor in the page field, as :42 goes to a line
            // in Vim.
            if (event.text == "o") { root.open-document(); return accept; }
            if (event.text == "t") { root.toggle-sidebar(); return accept; }
            if (event.text == ":") { page-field.take-focus(); return accept; }
            // The arrows, and H, J, K and L as in Vim; Shift+J, Shift+K and
            // Shift+Space turn pages too, as in zathura.
            if (event.text == Key.UpArrow || event.text == "k") { root.nav-line(-1); return accept; }
            if (event.text == Key.DownArrow || event.text == "j") { root.nav-line(1); return accept; }
            if (event.text == Key.LeftArrow || event.text == "h" || event.text == "K") { root.nav-page(-1); return accept; }
            if (event.text == Key.RightArrow || event.text == "l" || event.text == "J") { root.nav-page(1); return accept; }
            if (event.text == Key.PageUp) { root.nav-page(-1); return accept; }
            if (event.text == Key.PageDown) { root.nav-page(1); return accept; }
            if (event.text == " ") { root.nav-page(event.modifiers.shift ? -1 : 1); return accept; }
            if (event.text == Key.Home) { root.nav-home(); return accept; }
            if (event.text == Key.End) { root.nav-end(); return accept; }
            return reject;
        }

        VerticalLayout {
            // Tab strip, shown even with a single document (or none), so the
            // open button always has a home. The button stays at the left edge,
            // so it never moves as tabs open and close.
            Rectangle {
                height: 38px;
                background: #262626;

                tab-strip := HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 2px;

                    VerticalLayout {
                        alignment: center;
                        // Sets the button a little apart from the first tab.
                        padding-right: 4px;
                        open-frame := Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: 5px;
                            background: open-button.pressed
                                ? #252525
                                : (open-button.has-hover ? #3a3a3a : transparent);
                            Image {
                                source: @image-url("icons/open.svg");
                                width: Toolbar.icon-size;
                                height: self.width;
                                colorize: open-button.pressed ? #ffffff : #dddddd;
                            }
                            open-button := TouchArea {
                                clicked => {
                                    root.open-document();
                                }
                            }
                            Tooltip {
                                text: @markdown("Open a PDF (O)");
                            }
                        }
                    }

                    for title[index] in root.tabs: DocumentTab {
                        title: title;
                        active: index == root.active-tab;
                        lifted: index == root.dragged-tab;
                        reordering: root.dragged-tab >= 0;
                        // Drawn over the tabs it passes.
                        z: self.lifted ? 1 : 0;
                        // The dragged tab follows the pointer, but no further
                        // than the ends of the strip, and the tabs it has
                        // passed each move over by one place to make room.
                        offset: self.lifted
                            ? max(-index * root.tab-stride, min((root.tabs.length - 1 - index) * root.tab-stride, root.tab-drag-x))
                            : root.dragged-tab < 0 ? 0px
                            : index > root.dragged-tab && index <= root.tab-drop-index ? -root.tab-stride
                            : index < root.dragged-tab && index >= root.tab-drop-index ? root.tab-stride
                            : 0px;
                        clicked => {
                            root.select-tab(index);
                        }
                        close => {
                            root.close-tab(index);
                        }
                        dragged(distance) => {
                            root.dragged-tab = index;
                            // Every tab is as wide as the others, so one
                            // tab's width and the gap after it is the
                            // distance between any two neighbours.
                            root.tab-stride = self.width + tab-strip.spacing;
                            root.tab-drag-x = distance;
                        }
                        dropped => {
                            let to = root.tab-drop-index;
                            root.dragged-tab = -1;
                            root.tab-drag-x = 0;
                            if (to != index) {
                                root.move-tab(index, to);
                            }
                        }
                        drag-cancelled => {
                            root.dragged-tab = -1;
                            root.tab-drag-x = 0;
                        }
                    }

                    // Takes the width the tabs leave, so they stay packed to
                    // the left behind the open button.
                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    // Help, at the strip's far end, as the open button is at
                    // its start.
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: 5px;
                            background: (root.help-open || help-toggle.pressed)
                                ? #252525
                                : (help-toggle.has-hover ? #3a3a3a : transparent);
                            Image {
                                source: @image-url("icons/help.svg");
                                width: Toolbar.icon-size;
                                height: self.width;
                                colorize: (root.help-open || help-toggle.pressed) ? #ffffff : #dddddd;
                            }
                            help-toggle := TouchArea {
                                clicked => {
                                    root.toggle-help();
                                }
                            }
                            Tooltip {
                                text: @markdown("Keyboard shortcuts (?)");
                            }
                        }
                    }
                }
            }

            // Toolbar. Fixed height so its contents never reflow the layout.
            Rectangle {
                height: 44px;
                background: #333333;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 6px;

                    // Sidebar toggle (recessed while the sidebar is open).
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: Toolbar.icon-size + 2 * Toolbar.h-padding;
                            height: 28px;
                            border-width: 1px;
                            border-color: #5a5a5a;
                            border-radius: 5px;
                            background: (root.sidebar-open || sidebar-toggle.pressed)
                                ? #252525
                                : (sidebar-toggle.has-hover ? #505050 : #454545);
                            Image {
                                source: @image-url("icons/menu.svg");
                                width: Toolbar.icon-size;
                                height: self.width;
                                colorize: (root.sidebar-open || sidebar-toggle.pressed) ? #ffffff : #dddddd;
                            }
                            sidebar-toggle := TouchArea {
                                clicked => {
                                    root.toggle-sidebar();
                                }
                            }
                            Tooltip {
                                text: @markdown("Outline and thumbnails (T)");
                            }
                        }
                    }

                    // Action groups: `current: -1` so no segment stays selected;
                    // they just fire on click (with press feedback).
                    VerticalLayout {
                        alignment: center;
                        zoom-group := SegmentedControl {
                            options: [@image-url("icons/zoom-out.svg"), @image-url("icons/zoom-in.svg")];
                            tips: ["Zoom out (-)", "Zoom in (+)"];
                            current: -1;
                            select(index) => {
                                if (index == 0) {
                                    root.zoom-out();
                                } else {
                                    root.zoom-in();
                                }
                            }
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        fit-group := SegmentedControl {
                            labels: ["Page Fit", "Page Width"];
                            tips: ["Fit the whole page in the window (A)", "Fit the page's width to the window (S)"];
                            current: -1;
                            select(index) => {
                                if (index == 0) {
                                    root.fit-page();
                                } else {
                                    root.fit-width();
                                }
                            }
                        }
                    }

                    // Fused segmented toggles for the two mode groups.
                    VerticalLayout {
                        alignment: center;
                        SegmentedControl {
                            options: [@image-url("icons/continuous.svg"), @image-url("icons/paged.svg")];
                            tips: ["Scroll through the pages (C)", "One page at a time (C)"];
                            current: root.continuous ? 0 : 1;
                            select(index) => {
                                root.set-continuous(index == 0);
                            }
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        spread-group := SegmentedControl {
                            options: [@image-url("icons/spread-single.svg"), @image-url("icons/spread-odd.svg"), @image-url("icons/spread-even.svg")];
                            tips: [
                                "Single pages (1)",
                                "Two pages side by side, from the first page (2)",
                                "Two pages side by side, the first page alone (3)",
                            ];
                            current: root.spread-mode;
                            select(index) => {
                                root.set-spread(index);
                            }
                        }
                    }

                    // Bookmarks: flip back to where the last jump came from,
                    // put the dog-ear on the page, and flag the page.
                    VerticalLayout {
                        alignment: center;
                        bookmark-group := SegmentedControl {
                            options: [
                                @image-url("icons/flip-back.svg"),
                                @image-url("icons/dog-ear.svg"),
                                @image-url("icons/bookmark.svg"),
                            ];
                            tips: [
                                "Flip back to where you came from (Tab)",
                                "Dog-ear this page, to flip back to it (M)",
                                "Bookmark this page, or take the bookmark away (D)",
                            ];
                            current: -1;
                            select(index) => {
                                if (index == 0) {
                                    root.flip-back();
                                } else if (index == 1) {
                                    root.mark-return-page();
                                } else {
                                    root.toggle-bookmark();
                                }
                            }
                        }
                    }

                    // Spacer pushes the page counter to the right.
                    Rectangle { horizontal-stretch: 1; }

                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            spacing: 5px;
                            page-field := PageField {
                                page: root.current-page;
                                go-to(value) => {
                                    root.go-to-page(value);
                                }
                                done => {
                                    key-handler.focus();
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: "/ \{root.page-count}";
                                    color: #dddddd;
                                }
                            }
                        }
                    }

                    // Search sidebar toggle, mirroring the one on the left.
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: Toolbar.icon-size + 2 * Toolbar.h-padding;
                            height: 28px;
                            border-width: 1px;
                            border-color: #5a5a5a;
                            border-radius: 5px;
                            background: (root.search-open || search-toggle.pressed)
                                ? #252525
                                : (search-toggle.has-hover ? #505050 : #454545);
                            Image {
                                source: @image-url("icons/search.svg");
                                width: Toolbar.icon-size;
                                height: self.width;
                                colorize: (root.search-open || search-toggle.pressed) ? #ffffff : #dddddd;
                            }
                            search-toggle := TouchArea {
                                clicked => {
                                    root.toggle-search();
                                }
                            }
                            Tooltip {
                                text: @markdown("Search the text (/)");
                            }
                        }
                    }
                }
            }

            HorizontalLayout {
                if root.sidebar-open: Rectangle {
                    width: 260px;
                    background: #2a2a2a;

                    VerticalLayout {
                        // Tab bar.
                        HorizontalLayout {
                            height: 34px;
                            Rectangle {
                                background: root.sidebar-tab == 0 ? #3a3a3a : #2a2a2a;
                                Text {
                                    text: "Outline";
                                    color: #dddddd;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                TouchArea {
                                    clicked => {
                                        root.sidebar-tab = 0;
                                    }
                                }
                            }
                            Rectangle {
                                background: root.sidebar-tab == 1 ? #3a3a3a : #2a2a2a;
                                Text {
                                    text: "Pages";
                                    color: #dddddd;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                TouchArea {
                                    clicked => {
                                        root.sidebar-tab = 1;
                                    }
                                }
                            }
                        }
                        Rectangle {
                            height: 1px;
                            background: #444444;
                        }

                        // Outline entries, indented by depth. An entry with no
                        // destination (page -1) is only a heading, so it is
                        // dimmed and does not respond to clicks.
                        if root.sidebar-tab == 0: ListView {
                            for item in root.outline: Rectangle {
                                height: 26px;
                                background: outline-touch.has-hover ? #383838 : transparent;
                                HorizontalLayout {
                                    padding-left: 8px + item.depth * 14px;
                                    padding-right: 8px;
                                    Text {
                                        text: item.title;
                                        color: item.page >= 0 ? #cccccc : #808080;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                                outline-touch := TouchArea {
                                    enabled: item.page >= 0;
                                    clicked => {
                                        root.go-to-page-index(item.page);
                                    }
                                }
                            }
                        }

                        // Page thumbnails, grouped like the current spread mode.
                        if root.sidebar-tab == 1: ListView {
                            for entry[idx] in root.thumb-rows: Rectangle {
                                height: 160px;
                                background: thumb-touch.has-hover ? #333333 : transparent;
                                VerticalLayout {
                                    padding-top: 6px;
                                    spacing: 2px;
                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 4px;
                                        ThumbView {
                                            entry: entry.left;
                                        }
                                        if entry.has-right: ThumbView {
                                            entry: entry.right;
                                        }
                                    }
                                    Text {
                                        text: entry.has-right
                                            ? "\{entry.left.page + 1}–\{entry.right.page + 1}"
                                            : "\{entry.left.page + 1}";
                                        color: #999999;
                                        horizontal-alignment: center;
                                    }
                                }
                                thumb-touch := TouchArea {
                                    clicked => {
                                        root.go-to-page-index(entry.left.page);
                                    }
                                }
                                init => {
                                    root.request-thumbnail-row(idx);
                                }
                            }
                        }
                    }
                }

                // The document column. Above the pages sits only the page
                // edge itself, a thin strip the flags hang from over the
                // pages.
                VerticalLayout {
                    if root.page-count > 0: Rectangle {
                        height: root.edge-height;
                        background: #2a2a2a;
                        Rectangle {
                            y: 0;
                            height: 1px;
                            background: #444444;
                        }
                    }

                    content := Rectangle {
                        // A click on the document hands the keys back to it from
                        // the search field. Sits under the views, which pass on
                        // the clicks they have no use for.
                        TouchArea {
                            clicked => {
                                key-handler.focus();
                            }
                        }

                        if root.page-count == 0: VerticalLayout {
                            alignment: center;
                            Text {
                                text: root.status;
                                horizontal-alignment: center;
                                wrap: word-wrap;
                            }
                        }

                        if root.page-count > 0 && root.continuous: ListView {
                            // Two-way bound so Rust can both read the scroll offset (for the
                            // page counter) and set it (to jump to a page).
                            content-y <=> root.scroll-y;
                            changed content-y => {
                                root.scrolled(-self.content-y / 1px);
                            }
                            scrolled => {
                                root.user-scrolled();
                            }
                            for entry[idx] in root.rows: PageRowView {
                                page-row: entry;
                                density: root.density;
                                row-height-pt: root.row-height-pt;
                                // Request pixels when this row scrolls into view. Zoom
                                // re-renders are driven from Rust (rerender_view).
                                init => {
                                    root.request-render-row(idx);
                                }
                                select-from(page, x, y) => { root.page-pressed(page, x, y); }
                                select-to(page, x, y) => { root.select-to(page, x, y); }
                                select-done => { root.select-done(); }
                                select-scroll(dx, dy, shift) => { root.select-scroll(dx, dy, shift); }
                                copy-selection => { root.copy-selection(); }
                                select-all => { root.select-all(); }
                            }
                        }

                        // Paged view: a Rust-controlled scroll surface. The wheel scrolls
                        // within the page and pages at the edges; content is positioned
                        // and sized by Rust so centering, scrolling, and shift-to-scroll-
                        // horizontally are all deterministic.
                        if root.page-count > 0 && !root.continuous: TouchArea {
                            clicked => {
                                key-handler.focus();
                            }
                            scroll-event(event) => {
                                root.paged-scroll(event.delta-x / 1px, event.delta-y / 1px, event.modifiers.shift);
                                return accept;
                            }
                            Rectangle {
                                clip: true;
                                Rectangle {
                                    x: root.paged-offset-x;
                                    y: root.paged-offset-y;
                                    width: root.paged-content-w;
                                    height: root.paged-content-h;

                                    HorizontalLayout {
                                        spacing: PageLayout.spread-spacing;
                                        PageImageView {
                                            entry: root.current-row-content.left;
                                            density: root.density;
                                            select-from(page, x, y) => { root.page-pressed(page, x, y); }
                                            select-to(page, x, y) => { root.select-to(page, x, y); }
                                            select-done => { root.select-done(); }
                                            select-scroll(dx, dy, shift) => { root.select-scroll(dx, dy, shift); }
                                            copy-selection => { root.copy-selection(); }
                                            select-all => { root.select-all(); }
                                        }
                                        if root.current-row-content.has-right: PageImageView {
                                            entry: root.current-row-content.right;
                                            density: root.density;
                                            select-from(page, x, y) => { root.page-pressed(page, x, y); }
                                            select-to(page, x, y) => { root.select-to(page, x, y); }
                                            select-done => { root.select-done(); }
                                            select-scroll(dx, dy, shift) => { root.select-scroll(dx, dy, shift); }
                                            copy-selection => { root.copy-selection(); }
                                            select-all => { root.select-all(); }
                                        }
                                    }
                                }
                            }
                        }

                        // The reader's flags hang from the toolbar's edge over
                        // the top of the pages at their depth in the document,
                        // like sticky flags on a closed book, so every one is
                        // in view and a click flips to it, and the pages lose
                        // no room to them. A dog-ear marks the page Tab
                        // flips back to, and a bar over everything the page
                        // being read, so a flag's distance from it can be
                        // judged.
                        // Starts just under the strip's edge line, which stays
                        // whole above everything.
                        if root.page-count > 0: edge := Rectangle {
                            y: 1px - root.edge-height;
                            height: 16px + root.edge-height - 1px;

                            for flag in root.bookmarks: Rectangle {
                                x: root.flag-x(flag.page, edge.width, edge.absolute-position.x);
                                y: 0;
                                width: root.flag-width(edge.width);
                                // A flag pulls out a little under the pointer,
                                // and on the page being read.
                                height: root.edge-height - 1px + (flag-touch.has-hover || flag.page == root.current-page - 1 ? 16px : 11px);
                                animate height { duration: 80ms; }
                                // The flag itself: a rectangle down to
                                // its shaped end, and the end as a path
                                // (see `flag-end`).
                                Rectangle {
                                    y: 0;
                                    height: parent.height - root.flag-end(flag.shape, parent.width / 1px, parent.height / 1px, root.device-pixel) * 1px - root.device-pixel * 1px;
                                    background: flag.color;
                                }
                                Path {
                                    width: 100%;
                                    height: 100%;
                                    fit: ImageFit.preserve;
                                    commands: root.flag-path(flag.shape, self.width / 1px, self.height / 1px, root.device-pixel);
                                    fill: flag.color;
                                }
                                // The menu offers every colour and shape,
                                // with a check on the flag's own. Activating
                                // a checkable item flips its check, but
                                // every change replaces the flags wholesale,
                                // so the menu is built afresh with the check
                                // where it belongs.
                                flag-menu := ContextMenuArea {
                                    Menu {
                                        for color in root.palette: MenuItem {
                                            title: color.name;
                                            icon: color.swatch;
                                            checkable: true;
                                            checked: color.hue == flag.hue;
                                            activated => {
                                                root.color-bookmark(flag.page, color.hue);
                                            }
                                        }
                                        MenuSeparator { }
                                        for shape in root.shapes: MenuItem {
                                            title: shape.name;
                                            icon: shape.icon;
                                            checkable: true;
                                            checked: shape.shape == flag.shape;
                                            activated => {
                                                root.shape-bookmark(flag.page, shape.shape);
                                            }
                                        }
                                        MenuSeparator { }
                                        MenuItem {
                                            title: "Remove bookmark";
                                            activated => {
                                                root.remove-bookmark(flag.page);
                                            }
                                        }
                                    }
                                }
                                // The touch area sits over the menu area, so it
                                // opens the menu itself on a right click.
                                flag-touch := TouchArea {
                                    clicked => {
                                        root.go-to-bookmark(flag.page);
                                    }
                                    pointer-event(event) => {
                                        if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                                            flag-menu.show({ x: self.mouse-x, y: self.mouse-y });
                                        }
                                        // A middle click takes the flag away
                                        // without a menu, as it closes a tab.
                                        if (event.button == PointerEventButton.middle && event.kind == PointerEventKind.up) {
                                            root.remove-bookmark(flag.page);
                                        }
                                    }
                                }
                                Tooltip {
                                    text: @markdown("\{flag.label}");
                                }
                            }

                            // The page being read, over the flags.
                            Rectangle {
                                x: root.flag-x(root.current-page - 1, edge.width, edge.absolute-position.x);
                                y: 0;
                                width: root.flag-width(edge.width);
                                height: 3px;
                                background: #dddddd;
                            }

                            // The page to flip back to: a dog-ear folded down
                            // from the edge, last so nothing covers it, and
                            // small enough to leave whatever it sits on in
                            // view and taking no clicks from it, since Tab
                            // most often leads to a flag's page.
                            if root.return-page >= 0: Path {
                                x: root.flag-x(root.return-page, edge.width, edge.absolute-position.x) + (root.flag-width(edge.width) - self.width) / 2;
                                // Up under the edge line, so no gap shows
                                // between the fold and the edge.
                                y: -1px;
                                width: 10px;
                                height: 8px;
                                viewbox-width: 10;
                                viewbox-height: 8;
                                // Left open along the top: the fill closes the
                                // triangle, and the outline runs only down the
                                // two folded sides.
                                commands: "M 0 0 L 5 8 L 10 0";
                                fill: #eeeeee;
                                stroke: #2a2a2a;
                                stroke-width: 1px;
                            }
                        }
                    }
                }

                // Search sidebar: the query at the top and the hits below it.
                // Always there and only hidden, so Ctrl+F can focus its field.
                search-sidebar := Rectangle {
                    visible: root.search-open;
                    width: root.search-open ? 300px : 0px;
                    background: #2a2a2a;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 6px;

                        Rectangle {
                            // One line to start with, growing as the query
                            // wraps: a search by meaning can be a sentence.
                            height: max(28px, search-input.preferred-height + 10px);
                            border-width: 1px;
                            border-color: search-input.has-focus ? #6ea8fe : #5a5a5a;
                            border-radius: 4px;
                            background: #2b2b2b;

                            search-input := TextInput {
                                x: 8px;
                                // Leaves room for the clear button while it shows.
                                width: parent.width - (root.search-text == "" ? 16px : 32px);
                                height: 100%;
                                text <=> root.search-text;
                                color: #eeeeee;
                                font-size: 13px;
                                vertical-alignment: center;
                                wrap: word-wrap;
                                // Enter steps between hits (below) rather than
                                // breaking the line, so the field grows only
                                // as the query wraps.
                                single-line: false;
                                edited => {
                                    root.search-edited(self.text);
                                }
                                key-pressed(event) => {
                                    // Enter and Down go to the next hit,
                                    // Shift+Enter and Up to the previous one,
                                    // and Esc back to the document.
                                    if (event.text == Key.Return) {
                                        root.search-step(event.modifiers.shift ? -1 : 1);
                                        return accept;
                                    }
                                    if (event.text == Key.DownArrow) {
                                        root.search-step(1);
                                        return accept;
                                    }
                                    if (event.text == Key.UpArrow) {
                                        root.search-step(-1);
                                        return accept;
                                    }
                                    if (event.text == Key.Escape) {
                                        key-handler.focus();
                                        return accept;
                                    }
                                    return reject;
                                }
                            }
                            if root.search-text == "": Text {
                                x: 8px;
                                text: "Search";
                                color: #808080;
                                font-size: 13px;
                                vertical-alignment: center;
                                height: 100%;
                            }

                            // Clears the query as deleting it would, and keeps
                            // the cursor in the field for the next one.
                            if root.search-text != "": search-clear := Rectangle {
                                x: parent.width - 22px;
                                // Beside the first line, where the field
                                // starts, however tall it has grown.
                                y: 6px;
                                width: 16px;
                                height: 16px;
                                border-radius: self.width / 2;
                                background: search-clear-touch.pressed
                                    ? #a0a0a0
                                    : (search-clear-touch.has-hover ? #8c8c8c : #6a6a6a);
                                accessible-role: button;
                                accessible-label: "Clear search";
                                accessible-action-default => {
                                    root.clear-search();
                                }

                                Path {
                                    x: 5px;
                                    y: 5px;
                                    width: 6px;
                                    height: 6px;
                                    viewbox-width: 6;
                                    viewbox-height: 6;
                                    commands: "M 0 0 L 6 6 M 6 0 L 0 6";
                                    stroke: #2b2b2b;
                                    stroke-width: 1.5px;
                                }

                                search-clear-touch := TouchArea {
                                    clicked => {
                                        root.clear-search();
                                    }
                                }
                            }
                        }

                        // The switch between the two kinds of search, one
                        // half pressed in.
                        Rectangle {
                            height: 24px;
                            border-radius: 4px;
                            background: #353535;
                            HorizontalLayout {
                                padding: 2px;
                                spacing: 2px;
                                for mode[index] in ["Exact", "Meaning"]: Rectangle {
                                    border-radius: 3px;
                                    background: root.search-mode == index
                                        ? #505050
                                        : (mode-touch.has-hover ? #404040 : transparent);
                                    accessible-role: button;
                                    accessible-label: mode;
                                    accessible-checked: root.search-mode == index;
                                    accessible-action-default => {
                                        root.set-search-mode(index);
                                    }
                                    Text {
                                        text: mode;
                                        color: root.search-mode == index ? #ffffff : #bbbbbb;
                                        font-size: 12px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    mode-touch := TouchArea {
                                        clicked => {
                                            root.set-search-mode(index);
                                        }
                                    }
                                }
                            }
                        }

                        Text {
                            text: root.search-status;
                            color: #999999;
                            font-size: 12px;
                            wrap: word-wrap;
                        }

                        search-list := ListView {
                            for result[index] in root.search-results: VerticalLayout {
                                padding-top: result.page-hits > 0 && index > 0 ? root.search-heading-gap : 0px;
                                if result.page-hits > 0: HorizontalLayout {
                                    height: root.search-heading-height;
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    padding-bottom: 2px;
                                    Text {
                                        text: "Page \{result.page + 1}";
                                        color: #999999;
                                        font-size: 11px;
                                        horizontal-stretch: 1;
                                    }
                                    if result.page-hits > 1: Text {
                                        text: "\{result.page-hits} matches";
                                        color: #808080;
                                        font-size: 11px;
                                    }
                                }
                                search-result := Rectangle {
                                    height: root.search-row-height;
                                    border-radius: 3px;
                                    accessible-role: list-item;
                                    accessible-label: result.before + result.found + result.after;
                                    accessible-item-selected: index == root.search-current;
                                    background: index == root.search-current
                                        ? #3a4a60
                                        : (result-touch.has-hover ? #333333 : transparent);
                                    // A row too narrow for its text keeps the
                                    // hit in full if it can, then as much of
                                    // the text just before it as fits, cut
                                    // from the start, and the text after gives
                                    // way first. Laid out by hand, as a layout
                                    // would widen the list to fit the text.
                                    property <length> room: self.width - 12px;
                                    property <length> found-width: min(found-text.preferred-width, self.room);
                                    property <length> before-width: min(before-text.preferred-width, self.room - self.found-width);
                                    Rectangle {
                                        x: 6px;
                                        width: parent.before-width;
                                        clip: true;
                                        before-text := Text {
                                            x: parent.width - self.width;
                                            width: self.preferred-width;
                                            height: 100%;
                                            text: result.before;
                                            color: #cccccc;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                        }
                                    }
                                    found-text := Text {
                                        x: 6px + parent.before-width;
                                        width: parent.found-width;
                                        height: 100%;
                                        text: result.found;
                                        color: #ffffff;
                                        font-size: 12px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    Text {
                                        x: 6px + parent.before-width + parent.found-width;
                                        width: max(0px, parent.room - parent.before-width - parent.found-width);
                                        height: 100%;
                                        text: result.after;
                                        color: #cccccc;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    result-touch := TouchArea {
                                        clicked => {
                                            root.go-to-search-result(index);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // Problems are reported over the bottom of the window, where they stay in
    // view whatever the document shows. A click dismisses one early.
    if root.notice != "": notice-banner := Rectangle {
        width: min(640px, root.width - 32px);
        height: notice-layout.preferred-height;
        x: (root.width - self.width) / 2;
        y: root.height - self.height - 24px;
        background: #5c2323;
        border-width: 1px;
        border-color: #8a3a3a;
        border-radius: 6px;

        notice-layout := VerticalLayout {
            padding: 10px;
            Text {
                text: root.notice;
                color: #ffffff;
                wrap: word-wrap;
                horizontal-alignment: center;
            }
        }
        TouchArea {
            clicked => {
                root.notice = "";
            }
        }
    }

    // The help page: every shortcut, and how the bookmarks work. A click
    // outside the page puts it away, as Esc does.
    if root.help-open: help-overlay := Rectangle {
        width: 100%;
        height: 100%;
        background: #000000a0;
        TouchArea {
            clicked => {
                root.help-open = false;
            }
        }

        help-panel := Rectangle {
            width: min(800px, root.width - 32px);
            // The slack keeps a page that fits from scrolling by the pixel
            // that rounding the wrapped text can leave over.
            height: min(help-content.preferred-height + 4px, root.height - 32px);
            background: #2a2a2a;
            border-width: 1px;
            border-color: #4a4a4a;
            border-radius: 8px;
            clip: true;
            // Keeps clicks on the page from reaching the backdrop.
            TouchArea { }

            // Scrolls only when the window is too short for the page. The
            // text wraps to the page's width rather than widening it.
            ScrollView {
                content-width: self.visible-width;
                content-height: help-content.preferred-height;
                horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
                help-content := VerticalLayout {
                    padding: 24px;
                    spacing: 18px;

                    HorizontalLayout {
                        Text {
                            text: "Keyboard shortcuts";
                            color: #ffffff;
                            font-size: 18px;
                            font-weight: 700;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: "Esc closes";
                            color: #808080;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                    }

                    HorizontalLayout {
                        spacing: 36px;

                        VerticalLayout {
                            spacing: 18px;
                            alignment: start;
                            horizontal-stretch: 1;

                            HelpSection {
                                title: "Moving around";
                                HelpRow { keys: "J, K, Down, Up"; action: "Scroll, or turn the page at its edge in paged mode"; }
                                HelpRow { keys: "H, L, Left, Right"; action: "Previous or next page"; }
                                HelpRow { keys: "Shift+K, Shift+J"; action: "Previous or next page"; }
                                HelpRow { keys: "Page Up, Page Down"; action: "Previous or next page"; }
                                HelpRow { keys: "Space, Shift+Space"; action: "Next or previous page"; }
                                HelpRow { keys: "Home, End"; action: "First or last page"; }
                                HelpRow { keys: ":"; action: "Type a page number, then Enter to go there"; }
                            }

                            HelpSection {
                                title: "Zoom and fit";
                                HelpRow { keys: "+, -, ="; action: "Zoom in, zoom out, 100%"; }
                                HelpRow { keys: "\{root.command-key}+, \{root.command-key}-, \{root.command-key}0"; action: "The same"; }
                                HelpRow { keys: "S, A"; action: "Fit the page width, fit the whole page"; }
                                HelpRow { keys: "C"; action: "Switch between continuous and paged"; }
                                HelpRow { keys: "1, 2, 3"; action: "Single pages, odd spreads, even spreads"; }
                            }
                        }

                        VerticalLayout {
                            spacing: 18px;
                            alignment: start;
                            horizontal-stretch: 1;

                            HelpSection {
                                title: "Search";
                                HelpRow { keys: "/, \{root.command-key}F"; action: "Search, with the cursor in the field"; }
                                HelpRow { keys: "\{root.command-key}Shift+F"; action: "Search by meaning, or by the letters again"; }
                                HelpRow { keys: "N, Shift+N"; action: "Next or previous hit"; }
                                HelpRow { keys: "Enter, Shift+Enter"; action: "Next or previous hit, in the field"; }
                                HelpRow { keys: "Esc"; action: "Back to the document from a field"; }
                            }

                            HelpSection {
                                title: "Text";
                                HelpRow { keys: "Drag, double-click, triple-click"; action: "Select text, a word, a line"; }
                                HelpRow { keys: "\{root.command-key}C"; action: "Copy the selected text"; }
                                HelpRow { keys: "\{root.command-key}A"; action: "Select the whole document"; }
                                HelpRow { keys: "Esc"; action: "Let the selection go"; }
                            }

                            HelpSection {
                                title: "Bookmarks";
                                HelpRow { keys: "D"; action: "Flag the page, or take its flag away"; }
                                HelpRow { keys: "B, Shift+B"; action: "Next or previous flag"; }
                                HelpRow { keys: "M"; action: "Dog-ear the page"; }
                                HelpRow { keys: "Tab"; action: "Flip between the dog-ear and where you are"; }
                            }

                            HelpSection {
                                title: "Tabs, files and help";
                                HelpRow { keys: "O, \{root.command-key}O"; action: "Open a PDF"; }
                                HelpRow { keys: "T"; action: "Show or hide the outline and thumbnails"; }
                                HelpRow { keys: "Ctrl+Tab, Ctrl+Shift+Tab"; action: "Next or previous tab"; }
                                HelpRow { keys: "\{root.command-key}1 to \{root.command-key}9"; action: "That tab, or the last one"; }
                                HelpRow { keys: "\{root.command-key}W"; action: "Close the tab"; }
                                HelpRow { keys: "?, F1"; action: "Show or hide this page"; }
                            }
                        }
                    }

                    HelpSection {
                        title: "How bookmarks work";
                        Text {
                            text: "Flags are sticky bookmarks on a closed book. Each hangs from the top edge over the pages at its page's depth in the document, so every one is in view at once, and a click on one, or B, goes there. Each new flag takes the next colour and shape in turn, and a right click on one picks its colour or shape, or takes it away.";
                            color: #bbbbbb;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                        Text {
                            text: "The dog-ear is your reading place, one per document. Going to a flag, or to a page typed after a colon, dog-ears the page you left, and Tab flips back to it and forward again, so a flag and your place swap like a ribbon and a bookmark. M dog-ears the page you are on by hand.";
                            color: #bbbbbb;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }

    // Shown while files dragged from another application are over the window,
    // so it is clear that letting go opens them.
    if root.drop-hover: drop-overlay := Rectangle {
        width: 100%;
        height: 100%;
        background: #00000099;
        border-width: 3px;
        border-color: #6ea8fe;
        Text {
            text: "Drop to open in a new tab";
            color: #ffffff;
            font-size: 20px;
        }
    }
}
