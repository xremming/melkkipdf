import { ListView, ScrollView, Spinner } from "std-widgets.slint";

// Shared toolbar metrics, so the standalone buttons and the segmented controls
// give their icons the same breathing room. Exported for the layout tests.
export global Toolbar {
    out property <length> icon-size: 18px;
    out property <length> h-padding: 16px;
}

// How pages are spaced. The viewer reads these for its scroll and fit math,
// so they are defined here once and the two cannot drift apart.
export global PageLayout {
    // The gap between rows in continuous mode, half above the pages and half
    // below, as part of each row's height.
    out property <length> row-gap: 16px;
    // The gap between the two pages of a spread.
    out property <length> spread-spacing: 4px;
}

// An area of a page to highlight, such as a search hit, in points from the
// page's top-left corner. `current` marks the hit the reader is on.
export struct Highlight {
    x: float,
    y: float,
    width: float,
    height: float,
    current: bool,
}

// One page's fixed size (in PDF points) and its rendered image. The image is
// empty until the page has been rendered, and stays empty if rendering failed.
export struct PageEntry {
    page: int,
    width-pt: float,
    height-pt: float,
    image: image,
    failed: bool,
    highlights: [Highlight],
}

// One search hit in the results list: its 0-based page, and the text found
// with some of the text before and after it. `page-hits` is how many hits its
// page has on the page's first hit, and 0 on the rest, so the list heads each
// page's hits once. `headings` is how many page headings the list has down to
// and including this hit's own, so the list can tell where the hit sits.
export struct SearchResult {
    page: int,
    page-hits: int,
    headings: int,
    before: string,
    found: string,
    after: string,
}

// A row in the document: a single page, or two pages side by side (a spread).
// When `has-right` is false, `right` is unused. `scale` shrinks a row far larger
// than the document's usual one, such as a fold-out map, so it fits the height
// every row in the continuous view shares; it is 1 for every other row.
export struct PageRow {
    left: PageEntry,
    right: PageEntry,
    has-right: bool,
    scale: float,
}

// One entry in the document outline (table of contents).
export struct OutlineItem {
    title: string,
    page: int,
    depth: int,
}

// A single page: white paper with the rendered image on top. Sized from the
// page's points times the shared density.
component PageImageView inherits Rectangle {
    in property <PageEntry> entry;
    in property <float> density;
    width: entry.width-pt * density * 1px;
    height: entry.height-pt * density * 1px;
    background: white;
    Image {
        source: entry.image;
        width: 100%;
        height: 100%;
    }

    // Search hits, drawn over the page, the one the reader is on stronger.
    for highlight in entry.highlights: Rectangle {
        x: highlight.x * density * 1px;
        y: highlight.y * density * 1px;
        width: highlight.width * density * 1px;
        height: highlight.height * density * 1px;
        background: highlight.current ? #ff8c0080 : #ffd24d66;
    }

    // A spinner while the page has not been rendered yet (empty image). It
    // disappears as soon as the rendered image arrives.
    if entry.image.width == 0 && !entry.failed: Spinner {
        width: min(36px, parent.width / 4);
        height: self.width;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        indeterminate: true;
    }

    // A page that failed to render says so, rather than spinning forever.
    if entry.failed: Text {
        width: parent.width - 16px;
        text: "This page could not be displayed.";
        color: #666666;
        horizontal-alignment: center;
        vertical-alignment: center;
        wrap: word-wrap;
    }
}

// A single fixed-size page thumbnail for the sidebar. The image is letterboxed
// into a uniform box so every thumbnail row is the same height (which the
// sidebar ListView needs for stable scrolling).
component ThumbView inherits Rectangle {
    in property <PageEntry> entry;
    width: 96px;
    height: 128px;
    background: white;
    border-width: 1px;
    border-color: #555555;

    Image {
        source: entry.image;
        width: 100%;
        height: 100%;
        image-fit: contain;
    }

    if entry.image.width == 0 && !entry.failed: Spinner {
        width: 24px;
        height: 24px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        indeterminate: true;
    }
}

// One row, centered horizontally and vertically. A single page centers on its
// own; a spread centers as a pair so the two pages meet at the middle.
//
// Every row reserves the same height (`row-height-pt`, the tallest of the
// document's usual rows, with larger rows scaled down to it). Slint's ListView
// assumes uniform item heights when estimating the scroll extent; giving it
// exactly that keeps the viewport anchor stable while scrolling instead of
// oscillating, which otherwise triggers a long instantiation-chain warning.
component PageRowView inherits Rectangle {
    in property <PageRow> page-row;
    in property <float> density;
    in property <float> row-height-pt;
    height: row-height-pt * density * 1px + PageLayout.row-gap;
    background: #2b2b2b;

    HorizontalLayout {
        alignment: center;
        spacing: PageLayout.spread-spacing;

        VerticalLayout {
            alignment: center;
            PageImageView {
                entry: page-row.left;
                density: root.density * page-row.scale;
            }
        }
        if page-row.has-right: VerticalLayout {
            alignment: center;
            PageImageView {
                entry: page-row.right;
                density: root.density * page-row.scale;
            }
        }
    }
}

// One segment of a fused segmented control. The active segment is recessed
// (darker) so it reads as pressed in. Its content is tinted to match the state.
// Carries an icon, or a text label where pdf.js has no icon to borrow.
component Segment inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> active;
    in property <bool> divider;
    // Slint has no minimum-padding property, but an inner layout is the same
    // thing: its padding is part of the segment's minimum width, so this is the
    // narrowest gap the content can ever get, and a wider segment just centers
    // the content in the extra space.
    in property <length> h-padding;
    callback clicked <=> touch.clicked;

    // Recessed while selected (radio use) or held down (action use).
    background: (root.active || touch.pressed)
        ? #252525
        : (touch.has-hover ? #505050 : #454545);
    property <brush> tint: (root.active || touch.pressed) ? #ffffff : #b8b8b8;

    HorizontalLayout {
        alignment: center;
        padding-left: root.h-padding;
        padding-right: root.h-padding;

        // The icon is a fixed size, which a HorizontalLayout would otherwise pin
        // to the top of the segment, so center it on the cross axis by hand.
        if root.label == "": VerticalLayout {
            alignment: center;
            icon-image := Image {
                source: root.icon;
                width: Toolbar.icon-size;
                height: self.width;
                // The source icons are solid black, so colorize carries the tint.
                colorize: root.tint;
            }
        }

        if root.label != "": label-text := Text {
            text: root.label;
            color: root.tint;
            font-size: 13px;
            vertical-alignment: center;
        }
    }

    // Divider between segments (drawn on the left edge of all but the first).
    if root.divider: Rectangle {
        x: 0;
        width: 1px;
        background: #5a5a5a;
    }

    touch := TouchArea { }
}

// A fused, segmented toggle: the options render as one control with rounded ends
// and shared borders. Emits `select` with the chosen index. A control fills
// either `options` (icons) or `labels` (text), never both.
component SegmentedControl inherits Rectangle {
    in property <[image]> options;
    in property <[string]> labels;
    in property <int> current;
    // Guaranteed gap on each side of every segment's icon or label, which is
    // what sizes the control now that it hugs its content.
    in property <length> segment-padding: Toolbar.h-padding;
    callback select(int);

    height: 28px;
    // A Rectangle has no natural width, so without this the control would
    // stretch to fill the toolbar instead of hugging its segments.
    horizontal-stretch: 0;
    border-width: 1px;
    border-color: #5a5a5a;
    border-radius: 5px;
    // Clip so the square-cornered segments are rounded off at the ends.
    clip: true;

    HorizontalLayout {
        for option[idx] in root.options: Segment {
            icon: option;
            active: idx == root.current;
            divider: idx > 0;
            h-padding: root.segment-padding;
            clicked => {
                root.select(idx);
            }
        }
        for text[idx] in root.labels: Segment {
            label: text;
            active: idx == root.current;
            divider: idx > 0;
            h-padding: root.segment-padding;
            clicked => {
                root.select(idx);
            }
        }
    }
}

// An editable page-number field. Shows the current page and, on Enter, emits the
// typed text for the viewer to jump to. Styled to match the dark toolbar.
component PageField inherits Rectangle {
    in property <int> page;
    callback go-to(string);

    width: 48px;
    height: 26px;
    border-width: 1px;
    border-color: #5a5a5a;
    border-radius: 4px;
    background: #2b2b2b;

    input := TextInput {
        width: 100%;
        height: 100%;
        // One-way binding: user edits persist until `page` changes externally
        // (scroll/nav), which then refreshes the field.
        text: "\{root.page}";
        color: #eeeeee;
        font-size: 14px;
        horizontal-alignment: center;
        vertical-alignment: center;
        single-line: true;
        input-type: number;
        accepted => {
            root.go-to(self.text);
        }
    }
}

// One browser-style tab: the document's name and a button that closes it. The
// active tab takes the toolbar's colour, so it reads as joined to the toolbar
// below it, as a browser's tab does to its address bar.
//
// A tab can be dragged along the strip to reorder it. The strip decides where
// it lands, so the tab only reports how far it has been dragged and when it is
// let go, and draws itself `offset` away from its place while the others make
// room for it.
component DocumentTab inherits Rectangle {
    in property <string> title;
    in property <bool> active;
    // How far the tab is drawn from its place in the strip.
    in property <length> offset;
    // Whether the offset follows the pointer, rather than easing into place
    // as a tab making room for a dragged one does.
    in property <bool> lifted;
    // Whether any tab of the strip is being dragged. Only then do tabs ease
    // into place: once one is dropped, they are already where they belong.
    in property <bool> reordering;
    callback clicked();
    callback close();
    // How far the pointer has moved along the strip since the tab was pressed.
    callback dragged(length);
    callback dropped();
    callback drag-cancelled();

    // Tabs share the strip like a browser's: as wide as a title needs up to a
    // cap, then narrowing together as more open. No minimum, so a long row of
    // tabs never forces the window wider than the screen.
    min-width: 0;
    preferred-width: 220px;
    max-width: 220px;
    horizontal-stretch: 1;

    // Stays in the tab's place while the face moves, so the distance dragged
    // is measured from where the tab was pressed. Declared before the face so
    // the close button, drawn on top, gets its own clicks.
    touch := TouchArea {
        // Only the left button drags, and only once it has moved far enough
        // that a click with a shaky hand still just selects the tab.
        property <bool> left-down;
        property <bool> dragging;

        pointer-event(event) => {
            if (event.kind == PointerEventKind.cancel) {
                if (self.dragging) {
                    root.drag-cancelled();
                }
                self.left-down = false;
                self.dragging = false;
            }
            if (event.button == PointerEventButton.left) {
                // A tab is selected as soon as it is pressed, as in a
                // browser, so the one being dragged is the one shown.
                if (event.kind == PointerEventKind.down) {
                    self.left-down = true;
                    root.clicked();
                }
                if (event.kind == PointerEventKind.up) {
                    if (self.dragging) {
                        root.dropped();
                    }
                    self.left-down = false;
                    self.dragging = false;
                }
            }
            // A middle click closes a tab in every browser.
            if (event.button == PointerEventButton.middle && event.kind == PointerEventKind.up) {
                root.close();
            }
        }
        moved => {
            if (self.left-down && !self.dragging && abs(self.mouse-x - self.pressed-x) > 5px) {
                self.dragging = true;
            }
            if (self.dragging) {
                root.dragged(self.mouse-x - self.pressed-x);
            }
        }
    }

    face := Rectangle {
        x: root.lifted ? root.offset : eased-offset;
        width: root.width;
        height: root.height;
        clip: true;
        border-top-left-radius: 6px;
        border-top-right-radius: 6px;
        background: root.active ? #333333 : (touch.has-hover ? #2e2e2e : transparent);

        property <length> eased-offset: root.offset;
        animate eased-offset {
            duration: 150ms;
            easing: ease-out;
            enabled: root.reordering;
        }

        HorizontalLayout {
            padding-left: 12px;
            padding-right: 6px;
            spacing: 4px;

            tab-title := Text {
                text: root.title;
                color: root.active ? #eeeeee : #aaaaaa;
                font-size: 13px;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }

            VerticalLayout {
                alignment: center;
                close-button := Rectangle {
                    width: 18px;
                    height: 18px;
                    border-radius: 3px;
                    background: close-touch.has-hover ? #555555 : transparent;
                    Path {
                        width: 8px;
                        height: 8px;
                        viewbox-width: 8;
                        viewbox-height: 8;
                        commands: "M 0 0 L 8 8 M 8 0 L 0 8";
                        stroke: root.active || close-touch.has-hover ? #dddddd : #999999;
                        stroke-width: 1.5px;
                    }
                    close-touch := TouchArea {
                        clicked => {
                            root.close();
                        }
                    }
                }
            }
        }
    }
}

// Top-level window: a toolbar above the document, shown either as a continuous
// scrollable column of rows or one row at a time.
export component MainWindow inherits Window {
    in property <[PageRow]> rows;
    in property <PageRow> current-row-content;
    in property <bool> continuous: true;
    in property <float> density: 1.333;
    in property <float> row-height-pt: 1.0;
    // Spread mode for the toolbar radios: 0 = single, 1 = odd, 2 = even.
    in property <int> spread-mode;
    // 1-based page currently at the top of the view, and total page count.
    in property <int> current-page;
    in property <int> page-count;
    // Two-way bound to the ListView's scroll offset so Rust can jump to a page.
    in-out property <length> scroll-y;
    // Shown in the document area while no document is open.
    in property <string> status;
    // A problem to tell the reader about, such as a document or page that
    // failed to open, shown over the document until dismissed or replaced.
    // Empty while there is nothing to report.
    in-out property <string> notice;

    // Sidebar: the document outline, thumbnail rows (grouped like the current
    // spread mode), and which tab is showing (0 = outline, 1 = pages).
    in property <[OutlineItem]> outline;
    in property <[PageRow]> thumb-rows;
    in-out property <bool> sidebar-open: true;
    in-out property <int> sidebar-tab;

    // The name of the open document, shown in the window title bar.
    in property <string> doc-title;

    // Whether files dragged from another application are over the window.
    in property <bool> drop-hover;

    // The search sidebar on the right: whether it is open, the query, a line
    // saying how the search went, the hits, and the index of the one the
    // reader is on (-1 for none).
    in-out property <bool> search-open;
    in-out property <string> search-text;
    in property <string> search-status;
    in property <[SearchResult]> search-results;
    in property <int> search-current: -1;
    // The query was edited.
    callback search-edited(string);
    // Move to the next (+1) or previous (-1) hit.
    callback search-step(int);
    // Move to a hit picked from the results list, by its index there.
    callback go-to-search-result(int);
    // Invoked from Rust when a document's indexer has read more pages, so
    // the app can take them in.
    callback text-indexed();

    // Setting the text from here does not count as an edit, so the app is
    // told the query is empty the way typing would tell it.
    function clear-search() {
        root.search-text = "";
        root.search-edited("");
        search-input.focus();
    }

    // The heights of a hit's row in the results list, of a page's heading
    // above its first hit, and of the gap above every heading but the first.
    property <length> search-row-height: 24px;
    property <length> search-heading-height: 16px;
    property <length> search-heading-gap: 6px;

    // Keeps the current hit, with its page's heading if it has one, in view
    // in the results list. The list only builds the rows it shows, so where
    // the hit sits is worked out from the headings above it.
    changed search-current => {
        if (root.search-current >= 0 && root.search-current < root.search-results.length) {
            let result = root.search-results[root.search-current];
            let bottom = (root.search-current + 1) * root.search-row-height
                + result.headings * root.search-heading-height
                + (result.headings - 1) * root.search-heading-gap;
            let top = bottom - root.search-row-height
                - (result.page-hits > 0 ? root.search-heading-height : 0px);
            if (top < -search-list.content-y) {
                search-list.content-y = -top;
            } else if (bottom > search-list.visible-height - search-list.content-y) {
                search-list.content-y = search-list.visible-height - bottom;
            }
        }
    }

    // Opening the search sidebar puts the cursor in its field, and closing
    // it hands the keys back to the document.
    function toggle-search() {
        root.search-open = !root.search-open;
        if (root.search-open) {
            search-input.focus();
        } else {
            key-handler.focus();
        }
    }

    // One title per open document, in tab order, and the index of the tab
    // shown (-1 while nothing is open).
    in property <[string]> tabs;
    in property <int> active-tab: -1;

    // The tab being dragged along the strip (-1 while none is), how far it
    // has been dragged, the distance from one tab to the next, and the place
    // it would land if let go now.
    property <int> dragged-tab: -1;
    property <length> tab-drag-x;
    property <length> tab-stride;
    property <int> tab-drop-index: root.dragged-tab < 0 || root.tab-stride <= 0
        ? root.dragged-tab
        : max(0, min(root.tabs.length - 1, root.dragged-tab + round(root.tab-drag-x / root.tab-stride)));

    // Open a new PDF in a new tab (prompts for a file with a native picker).
    callback open-document();
    callback select-tab(int);
    callback close-tab(int);
    // Moves the tab at the first index to the second, shifting the ones
    // between over by one.
    callback move-tab(int, int);
    callback toggle-sidebar();
    // Jump to a 0-based page (from the outline or a thumbnail).
    callback go-to-page-index(int);
    // A visible thumbnail row wants its pages rendered (row index).
    callback request-thumbnail-row(int);
    // Invoked from Rust when a page thumbnail has rendered (document id, page
    // index, image). Every tab's worker reports here, hence the document id.
    callback thumbnail-rendered(int, int, image);
    callback request-render-row(int);
    // Invoked from Rust when a page has rendered (document id, page, the scale
    // it was asked for at, image).
    callback page-rendered(int, int, float, image);
    // Invoked from Rust when a page failed to render (document id, page), or
    // its thumbnail failed to.
    callback page-failed(int, int);
    callback thumbnail-failed(int, int);
    // Invoked from Rust with a problem to show the reader.
    callback notify(string);
    // Invoked from Rust when a document's worker has finished reading it, so
    // the app can take in what it read.
    callback document-loaded();
    // Invoked from Rust when another instance has been asked to open
    // documents, so the app can open them here instead.
    callback documents-requested();
    callback viewport-resized(length, length);
    // Continuous scroll offset changed (logical pixels from the top).
    callback scrolled(float);
    // The reader scrolled the continuous list themselves, as opposed to the
    // offset changing because the viewer set it or the list laid itself out.
    callback user-scrolled();
    callback zoom-in();
    callback zoom-out();
    callback zoom-reset();
    callback fit-width();
    callback fit-page();
    callback set-continuous(bool);
    callback toggle-continuous();
    // Jump to a page from the toolbar field (raw text, parsed in Rust).
    callback go-to-page(string);
    // Spread mode: 0 = single, 1 = odd, 2 = even.
    callback set-spread(int);
    // Navigation (dir -1 = up/back, +1 = down/forward).
    callback nav-line(int);
    callback nav-page(int);
    callback nav-home();
    callback nav-end();
    // Paged-mode wheel: (delta-x, delta-y, shift). Rust scrolls within the page
    // and pages at the edges.
    callback paged-scroll(float, float, bool);

    // Paged view geometry, computed by Rust: where to place the current page's
    // content within the viewport, and the content's size.
    in property <length> paged-offset-x;
    in property <length> paged-offset-y;
    in property <length> paged-content-w;
    in property <length> paged-content-h;

    title: root.doc-title == "" ? "melkkipdf" : root.doc-title + " — melkkipdf";
    preferred-width: 1000px;
    preferred-height: 1000px;
    forward-focus: key-handler;

    property <length> view-w: content.width;
    property <length> view-h: content.height;
    changed view-w => { root.viewport-resized(root.view-w, root.view-h); }
    changed view-h => { root.viewport-resized(root.view-w, root.view-h); }

    key-handler := FocusScope {
        key-pressed(event) => {
            if (event.modifiers.control && (event.text == "+" || event.text == "=")) {
                root.zoom-in();
                return accept;
            }
            if (event.modifiers.control && event.text == "-") {
                root.zoom-out();
                return accept;
            }
            if (event.modifiers.control && event.text == "0") {
                root.zoom-reset();
                return accept;
            }
            // Ctrl+F puts the cursor in the search field, opening the sidebar
            // if need be, and closes the sidebar again from the field. Once
            // Esc has left the field, it goes back to it rather than closing.
            if (event.modifiers.control && (event.text == "f" || event.text == "F")) {
                if (search-input.has-focus) {
                    root.toggle-search();
                } else {
                    root.search-open = true;
                    search-input.focus();
                }
                return accept;
            }
            // Browser tab shortcuts: Ctrl+W closes the tab, Ctrl+Tab and
            // Ctrl+Shift+Tab cycle through the tabs.
            if (event.modifiers.control && (event.text == "w" || event.text == "W")) {
                if (root.active-tab >= 0) {
                    root.close-tab(root.active-tab);
                }
                return accept;
            }
            if (event.modifiers.control && (event.text == Key.Tab || event.text == Key.Backtab)) {
                if (root.tabs.length > 1) {
                    if (event.modifiers.shift || event.text == Key.Backtab) {
                        root.select-tab(Math.mod(root.active-tab + root.tabs.length - 1, root.tabs.length));
                    } else {
                        root.select-tab(Math.mod(root.active-tab + 1, root.tabs.length));
                    }
                }
                return accept;
            }
            if (event.text == "f") { root.fit-width(); return accept; }
            if (event.text == "p") { root.fit-page(); return accept; }
            if (event.text == "c") { root.toggle-continuous(); return accept; }
            if (event.text == "1") { root.set-spread(0); return accept; }
            if (event.text == "2") { root.set-spread(1); return accept; }
            if (event.text == "3") { root.set-spread(2); return accept; }
            if (event.text == Key.UpArrow) { root.nav-line(-1); return accept; }
            if (event.text == Key.DownArrow) { root.nav-line(1); return accept; }
            if (event.text == Key.LeftArrow) { root.nav-page(-1); return accept; }
            if (event.text == Key.RightArrow) { root.nav-page(1); return accept; }
            if (event.text == Key.PageUp) { root.nav-page(-1); return accept; }
            if (event.text == Key.PageDown || event.text == " ") { root.nav-page(1); return accept; }
            if (event.text == Key.Home) { root.nav-home(); return accept; }
            if (event.text == Key.End) { root.nav-end(); return accept; }
            return reject;
        }

        VerticalLayout {
            // Tab strip, shown even with a single document (or none), so the
            // open button always has a home. The button stays at the left edge,
            // so it never moves as tabs open and close.
            Rectangle {
                height: 38px;
                background: #262626;

                tab-strip := HorizontalLayout {
                    padding-top: 6px;
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 2px;

                    VerticalLayout {
                        alignment: center;
                        // Sets the button a little apart from the first tab.
                        padding-right: 4px;
                        open-frame := Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: 5px;
                            background: open-button.pressed
                                ? #252525
                                : (open-button.has-hover ? #3a3a3a : transparent);
                            Image {
                                source: @image-url("icons/open.svg");
                                width: Toolbar.icon-size;
                                height: self.width;
                                colorize: open-button.pressed ? #ffffff : #dddddd;
                            }
                            open-button := TouchArea {
                                clicked => {
                                    root.open-document();
                                }
                            }
                        }
                    }

                    for title[index] in root.tabs: DocumentTab {
                        title: title;
                        active: index == root.active-tab;
                        lifted: index == root.dragged-tab;
                        reordering: root.dragged-tab >= 0;
                        // Drawn over the tabs it passes.
                        z: self.lifted ? 1 : 0;
                        // The dragged tab follows the pointer, but no further
                        // than the ends of the strip, and the tabs it has
                        // passed each move over by one place to make room.
                        offset: self.lifted
                            ? max(-index * root.tab-stride, min((root.tabs.length - 1 - index) * root.tab-stride, root.tab-drag-x))
                            : root.dragged-tab < 0 ? 0px
                            : index > root.dragged-tab && index <= root.tab-drop-index ? -root.tab-stride
                            : index < root.dragged-tab && index >= root.tab-drop-index ? root.tab-stride
                            : 0px;
                        clicked => {
                            root.select-tab(index);
                        }
                        close => {
                            root.close-tab(index);
                        }
                        dragged(distance) => {
                            root.dragged-tab = index;
                            // Every tab is as wide as the others, so one
                            // tab's width and the gap after it is the
                            // distance between any two neighbours.
                            root.tab-stride = self.width + tab-strip.spacing;
                            root.tab-drag-x = distance;
                        }
                        dropped => {
                            let to = root.tab-drop-index;
                            root.dragged-tab = -1;
                            root.tab-drag-x = 0;
                            if (to != index) {
                                root.move-tab(index, to);
                            }
                        }
                        drag-cancelled => {
                            root.dragged-tab = -1;
                            root.tab-drag-x = 0;
                        }
                    }

                    // Takes the width the tabs leave, so they stay packed to
                    // the left behind the open button.
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                }
            }

            // Toolbar. Fixed height so its contents never reflow the layout.
            Rectangle {
                height: 44px;
                background: #333333;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 6px;

                    // Sidebar toggle (recessed while the sidebar is open).
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: Toolbar.icon-size + 2 * Toolbar.h-padding;
                            height: 28px;
                            border-width: 1px;
                            border-color: #5a5a5a;
                            border-radius: 5px;
                            background: (root.sidebar-open || sidebar-toggle.pressed)
                                ? #252525
                                : (sidebar-toggle.has-hover ? #505050 : #454545);
                            Image {
                                source: @image-url("icons/menu.svg");
                                width: Toolbar.icon-size;
                                height: self.width;
                                colorize: (root.sidebar-open || sidebar-toggle.pressed) ? #ffffff : #dddddd;
                            }
                            sidebar-toggle := TouchArea {
                                clicked => {
                                    root.toggle-sidebar();
                                }
                            }
                        }
                    }

                    // Action groups: `current: -1` so no segment stays selected;
                    // they just fire on click (with press feedback).
                    VerticalLayout {
                        alignment: center;
                        zoom-group := SegmentedControl {
                            options: [@image-url("icons/zoom-out.svg"), @image-url("icons/zoom-in.svg")];
                            current: -1;
                            select(index) => {
                                if (index == 0) {
                                    root.zoom-out();
                                } else {
                                    root.zoom-in();
                                }
                            }
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        fit-group := SegmentedControl {
                            labels: ["Page Fit", "Page Width"];
                            current: -1;
                            select(index) => {
                                if (index == 0) {
                                    root.fit-page();
                                } else {
                                    root.fit-width();
                                }
                            }
                        }
                    }

                    // Fused segmented toggles for the two mode groups.
                    VerticalLayout {
                        alignment: center;
                        SegmentedControl {
                            options: [@image-url("icons/continuous.svg"), @image-url("icons/paged.svg")];
                            current: root.continuous ? 0 : 1;
                            select(index) => {
                                root.set-continuous(index == 0);
                            }
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        spread-group := SegmentedControl {
                            options: [@image-url("icons/spread-single.svg"), @image-url("icons/spread-odd.svg"), @image-url("icons/spread-even.svg")];
                            current: root.spread-mode;
                            select(index) => {
                                root.set-spread(index);
                            }
                        }
                    }

                    // Spacer pushes the page counter to the right.
                    Rectangle { horizontal-stretch: 1; }

                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            spacing: 5px;
                            page-field := PageField {
                                page: root.current-page;
                                go-to(value) => {
                                    root.go-to-page(value);
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: "/ \{root.page-count}";
                                    color: #dddddd;
                                }
                            }
                        }
                    }

                    // Search sidebar toggle, mirroring the one on the left.
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: Toolbar.icon-size + 2 * Toolbar.h-padding;
                            height: 28px;
                            border-width: 1px;
                            border-color: #5a5a5a;
                            border-radius: 5px;
                            background: (root.search-open || search-toggle.pressed)
                                ? #252525
                                : (search-toggle.has-hover ? #505050 : #454545);
                            Image {
                                source: @image-url("icons/search.svg");
                                width: Toolbar.icon-size;
                                height: self.width;
                                colorize: (root.search-open || search-toggle.pressed) ? #ffffff : #dddddd;
                            }
                            search-toggle := TouchArea {
                                clicked => {
                                    root.toggle-search();
                                }
                            }
                        }
                    }
                }
            }

            HorizontalLayout {
                if root.sidebar-open: Rectangle {
                    width: 260px;
                    background: #2a2a2a;

                    VerticalLayout {
                        // Tab bar.
                        HorizontalLayout {
                            height: 34px;
                            Rectangle {
                                background: root.sidebar-tab == 0 ? #3a3a3a : #2a2a2a;
                                Text {
                                    text: "Outline";
                                    color: #dddddd;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                TouchArea {
                                    clicked => {
                                        root.sidebar-tab = 0;
                                    }
                                }
                            }
                            Rectangle {
                                background: root.sidebar-tab == 1 ? #3a3a3a : #2a2a2a;
                                Text {
                                    text: "Pages";
                                    color: #dddddd;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                TouchArea {
                                    clicked => {
                                        root.sidebar-tab = 1;
                                    }
                                }
                            }
                        }
                        Rectangle {
                            height: 1px;
                            background: #444444;
                        }

                        // Outline entries, indented by depth. An entry with no
                        // destination (page -1) is only a heading, so it is
                        // dimmed and does not respond to clicks.
                        if root.sidebar-tab == 0: ListView {
                            for item in root.outline: Rectangle {
                                height: 26px;
                                background: outline-touch.has-hover ? #383838 : transparent;
                                HorizontalLayout {
                                    padding-left: 8px + item.depth * 14px;
                                    padding-right: 8px;
                                    Text {
                                        text: item.title;
                                        color: item.page >= 0 ? #cccccc : #808080;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                                outline-touch := TouchArea {
                                    enabled: item.page >= 0;
                                    clicked => {
                                        root.go-to-page-index(item.page);
                                    }
                                }
                            }
                        }

                        // Page thumbnails, grouped like the current spread mode.
                        if root.sidebar-tab == 1: ListView {
                            for entry[idx] in root.thumb-rows: Rectangle {
                                height: 160px;
                                background: thumb-touch.has-hover ? #333333 : transparent;
                                VerticalLayout {
                                    padding-top: 6px;
                                    spacing: 2px;
                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 4px;
                                        ThumbView {
                                            entry: entry.left;
                                        }
                                        if entry.has-right: ThumbView {
                                            entry: entry.right;
                                        }
                                    }
                                    Text {
                                        text: entry.has-right
                                            ? "\{entry.left.page + 1}–\{entry.right.page + 1}"
                                            : "\{entry.left.page + 1}";
                                        color: #999999;
                                        horizontal-alignment: center;
                                    }
                                }
                                thumb-touch := TouchArea {
                                    clicked => {
                                        root.go-to-page-index(entry.left.page);
                                    }
                                }
                                init => {
                                    root.request-thumbnail-row(idx);
                                }
                            }
                        }
                    }
                }

                content := Rectangle {
                    if root.page-count == 0: VerticalLayout {
                        alignment: center;
                        Text {
                            text: root.status;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }

                    if root.page-count > 0 && root.continuous: ListView {
                        // Two-way bound so Rust can both read the scroll offset (for the
                        // page counter) and set it (to jump to a page).
                        content-y <=> root.scroll-y;
                        changed content-y => {
                            root.scrolled(-self.content-y / 1px);
                        }
                        scrolled => {
                            root.user-scrolled();
                        }
                        for entry[idx] in root.rows: PageRowView {
                            page-row: entry;
                            density: root.density;
                            row-height-pt: root.row-height-pt;
                            // Request pixels when this row scrolls into view. Zoom
                            // re-renders are driven from Rust (rerender_view).
                            init => {
                                root.request-render-row(idx);
                            }
                        }
                    }

                    // Paged view: a Rust-controlled scroll surface. The wheel scrolls
                    // within the page and pages at the edges; content is positioned
                    // and sized by Rust so centering, scrolling, and shift-to-scroll-
                    // horizontally are all deterministic.
                    if root.page-count > 0 && !root.continuous: TouchArea {
                        scroll-event(event) => {
                            root.paged-scroll(event.delta-x / 1px, event.delta-y / 1px, event.modifiers.shift);
                            return accept;
                        }
                        Rectangle {
                            clip: true;
                            Rectangle {
                                x: root.paged-offset-x;
                                y: root.paged-offset-y;
                                width: root.paged-content-w;
                                height: root.paged-content-h;

                                HorizontalLayout {
                                    spacing: PageLayout.spread-spacing;
                                    PageImageView {
                                        entry: root.current-row-content.left;
                                        density: root.density;
                                    }
                                    if root.current-row-content.has-right: PageImageView {
                                        entry: root.current-row-content.right;
                                        density: root.density;
                                    }
                                }
                            }
                        }
                    }
                }

                // Search sidebar: the query at the top and the hits below it.
                // Always there and only hidden, so Ctrl+F can focus its field.
                search-sidebar := Rectangle {
                    visible: root.search-open;
                    width: root.search-open ? 300px : 0px;
                    background: #2a2a2a;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 6px;

                        Rectangle {
                            height: 28px;
                            border-width: 1px;
                            border-color: search-input.has-focus ? #6ea8fe : #5a5a5a;
                            border-radius: 4px;
                            background: #2b2b2b;

                            search-input := TextInput {
                                x: 8px;
                                // Leaves room for the clear button while it shows.
                                width: parent.width - (root.search-text == "" ? 16px : 32px);
                                height: 100%;
                                text <=> root.search-text;
                                color: #eeeeee;
                                font-size: 13px;
                                vertical-alignment: center;
                                single-line: true;
                                edited => {
                                    root.search-edited(self.text);
                                }
                                key-pressed(event) => {
                                    // Enter and Down go to the next hit,
                                    // Shift+Enter and Up to the previous one,
                                    // and Esc back to the document.
                                    if (event.text == Key.Return) {
                                        root.search-step(event.modifiers.shift ? -1 : 1);
                                        return accept;
                                    }
                                    if (event.text == Key.DownArrow) {
                                        root.search-step(1);
                                        return accept;
                                    }
                                    if (event.text == Key.UpArrow) {
                                        root.search-step(-1);
                                        return accept;
                                    }
                                    if (event.text == Key.Escape) {
                                        key-handler.focus();
                                        return accept;
                                    }
                                    return reject;
                                }
                            }
                            if root.search-text == "": Text {
                                x: 8px;
                                text: "Search";
                                color: #808080;
                                font-size: 13px;
                                vertical-alignment: center;
                                height: 100%;
                            }

                            // Clears the query as deleting it would, and keeps
                            // the cursor in the field for the next one.
                            if root.search-text != "": search-clear := Rectangle {
                                x: parent.width - 22px;
                                y: (parent.height - self.height) / 2;
                                width: 16px;
                                height: 16px;
                                border-radius: self.width / 2;
                                background: search-clear-touch.pressed
                                    ? #a0a0a0
                                    : (search-clear-touch.has-hover ? #8c8c8c : #6a6a6a);
                                accessible-role: button;
                                accessible-label: "Clear search";
                                accessible-action-default => {
                                    root.clear-search();
                                }

                                Path {
                                    x: 5px;
                                    y: 5px;
                                    width: 6px;
                                    height: 6px;
                                    viewbox-width: 6;
                                    viewbox-height: 6;
                                    commands: "M 0 0 L 6 6 M 6 0 L 0 6";
                                    stroke: #2b2b2b;
                                    stroke-width: 1.5px;
                                }

                                search-clear-touch := TouchArea {
                                    clicked => {
                                        root.clear-search();
                                    }
                                }
                            }
                        }

                        Text {
                            text: root.search-status;
                            color: #999999;
                            font-size: 12px;
                            wrap: word-wrap;
                        }

                        search-list := ListView {
                            for result[index] in root.search-results: VerticalLayout {
                                padding-top: result.page-hits > 0 && index > 0 ? root.search-heading-gap : 0px;
                                if result.page-hits > 0: HorizontalLayout {
                                    height: root.search-heading-height;
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    padding-bottom: 2px;
                                    Text {
                                        text: "Page \{result.page + 1}";
                                        color: #999999;
                                        font-size: 11px;
                                        horizontal-stretch: 1;
                                    }
                                    if result.page-hits > 1: Text {
                                        text: "\{result.page-hits} matches";
                                        color: #808080;
                                        font-size: 11px;
                                    }
                                }
                                search-result := Rectangle {
                                    height: root.search-row-height;
                                    border-radius: 3px;
                                    accessible-role: list-item;
                                    accessible-label: result.before + result.found + result.after;
                                    accessible-item-selected: index == root.search-current;
                                    background: index == root.search-current
                                        ? #3a4a60
                                        : (result-touch.has-hover ? #333333 : transparent);
                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        Text {
                                            text: result.before;
                                            color: #cccccc;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: result.found;
                                            color: #ffffff;
                                            font-size: 12px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: result.after;
                                            color: #cccccc;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                        }
                                    }
                                    result-touch := TouchArea {
                                        clicked => {
                                            root.go-to-search-result(index);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // Problems are reported over the bottom of the window, where they stay in
    // view whatever the document shows. A click dismisses one early.
    if root.notice != "": notice-banner := Rectangle {
        width: min(640px, root.width - 32px);
        height: notice-layout.preferred-height;
        x: (root.width - self.width) / 2;
        y: root.height - self.height - 24px;
        background: #5c2323;
        border-width: 1px;
        border-color: #8a3a3a;
        border-radius: 6px;

        notice-layout := VerticalLayout {
            padding: 10px;
            Text {
                text: root.notice;
                color: #ffffff;
                wrap: word-wrap;
                horizontal-alignment: center;
            }
        }
        TouchArea {
            clicked => {
                root.notice = "";
            }
        }
    }

    // Shown while files dragged from another application are over the window,
    // so it is clear that letting go opens them.
    if root.drop-hover: drop-overlay := Rectangle {
        width: 100%;
        height: 100%;
        background: #00000099;
        border-width: 3px;
        border-color: #6ea8fe;
        Text {
            text: "Drop to open in a new tab";
            color: #ffffff;
            font-size: 20px;
        }
    }
}
